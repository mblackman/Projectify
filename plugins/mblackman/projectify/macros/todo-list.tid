\procedure lingo-base() $:/language/projectify/

\procedure project-refile-actions()
<!-- Procedure similar to the todo-list drop actions, but used in project lists/cards -->
<$action-listops $tiddler=<<actionTiddler>> $tags=<<project-refile-tags>>/>
<$action-sendmessage $message="tm-auto-save-wiki"/>
\end

\procedure todo-list-drop-actions(tag)
<!-- Same as list-tagged-draggable-drop-actions, but removing the item from its old project and adding the todo tag. -->
<$action-listops $tiddler=<<actionTiddler>> $tags=<<todo-list-drop-tags>>/>
<%if [<targetSection>!is[blank]] %>
  <$action-setfield $tiddler=<<actionTiddler>> section=<<targetSection>>/>
<%elseif [<clearSectionOnDrop>match[yes]] %>
  <$action-deletefield $tiddler=<<actionTiddler>> $field="section"/>
<%endif%>
<!-- Save the current ordering of the tiddlers with this tag -->
<$set name="order" filter="[<tag>tagging[]]">
<!-- Remove any list-after or list-before fields from the tiddlers with this tag -->
<$list filter="[<tag>tagging[]]">
  <$action-deletefield $field="list-before"/>
  <$action-deletefield $field="list-after"/>
</$list>
<!-- Save the new order to the Tag Tiddler -->
<$action-listops $tiddler=<<tag>> $field="list" $filter="+[enlist:raw<order>] +[insertbefore<actionTiddler>,<currentTiddler>]"/>
<$action-sendmessage $message="tm-auto-save-wiki"/>
</$set>
\end

\define py-list-tagged-draggable(tag, subFilter, itemTemplate)
\whitespace trim
<span class="tc-tagged-draggable-list">
  <$set name="tag" value=<<__tag__>>>
    <$list filter="[<__tag__>tagging[]$subFilter$]">
      <div class="tc-menu-list-item">
        <$droppable
          actions="<$macrocall $name='list-tagged-draggable-drop-actions' tag=<<__tag__>>/>"
          enable=<<tv-enable-drag-and-drop>>
        >
          <div class="tc-droppable-placeholder"/>
          <div>
            <$transclude tiddler=<<__itemTemplate__>>>
              <div class="py-reorder-project-row">
                <$draggable
                  tag="span"
                  class="py-drag-handle"
                  tiddler={{!!title}}
                  data-tiddler-title={{!!title}}
                >
                  {{$:/plugins/mblackman/projectify/images/drag-handle}}
                </$draggable>
                <$link to={{!!title}}><$view field="title"/></$link>
              </div>
            </$transclude>
          </div>
        </$droppable>
      </div>
    </$list>
    <$tiddler tiddler="">
      <$droppable
        actions="<$macrocall $name='list-tagged-draggable-drop-actions' tag=<<__tag__>>/>"
        enable=<<tv-enable-drag-and-drop>>
        tag="div"
        class="py-list-end-dropzone"
      >
        <div class="tc-droppable-placeholder"/>
        <div class="py-list-end-dropzone-spacer"/>
      </$droppable>
    </$tiddler>
  </$set>
</span>
\end

\procedure todo-list-filtered(subFilter)
<$let
  projectTag={{!!title}}
  dragHandle="yes"
  list-tagged-draggable-drop-actions=<<todo-list-drop-actions>>
>
  <div class="py-todos">
    <$transclude
      $variable="py-list-tagged-draggable"
      tag=<<projectTag>>
      subFilter=<<subFilter>>
      itemTemplate="$:/plugins/mblackman/projectify/ui/todo/TodoItem"
    />
  </div>
</$let>
\end

\procedure section-inline-add-actions(sectionName, addState, openState)
<$action-py-quick-add
  $state=<<addState>>
  $field="todo-name"
  $tags={{{ [<currentTiddler>format:titlelist[]addsuffix[ todo]] }}}
  $section=<<sectionName>>
/>
<$action-deletetiddler $tiddler=<<openState>>/>
\end

\procedure todo-list-section(sectionName)
<$let
  sectionSubFilter="tag[todo]!has[draft.of]!tag[done]section<sectionName>"
  targetSection=<<sectionName>>
  secAddOpenState={{{ [[$:/state/projectify/section-add-open/]] [<currentTiddler>] [[/]] [<sectionName>] +[join[]] }}}
  secAddInputState={{{ [[$:/temp/projectify/section-add-input/]] [<currentTiddler>] [[/]] [<sectionName>] +[join[]] }}}
>
  <div class="py-project-section">
    <div class="py-section-header">
      <$droppable actions="<$action-setfield $tiddler=<<actionTiddler>> section=<<sectionName>>/><$action-sendmessage $message='tm-auto-save-wiki'/>" tag="div" class="py-section-title-drop">
        <span class="py-section-title"><$text text=<<sectionName>>/></span>
        <span class="py-count"><$count filter="[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]section<sectionName>]"/></span>
      </$droppable>
      <$button class="tc-btn-invisible py-section-delete" tooltip={{$:/language/projectify/DeleteSection/Hint}}>
        {{$:/core/images/delete-button}}
        <$action-listops $field="sections" $subfilter="-[<sectionName>]"/>
        <$list filter="[all[tiddlers]tag<currentTiddler>tag[todo]section<sectionName>]" variable="secTodo">
          <$action-deletefield $tiddler=<<secTodo>> $field="section"/>
        </$list>
        <$action-sendmessage $message="tm-auto-save-wiki"/>
      </$button>
    </div>
    <$transclude $variable="todo-list-filtered" subFilter=<<sectionSubFilter>>/>
    <div class="py-section-footer">
      <%if [<secAddOpenState>get[text]match[yes]] %>
        <div class="py-section-inline-add">
          <$keyboard key="escape" actions="<$action-deletetiddler $tiddler=<<secAddOpenState>>/>">
            <$py-quick-input
              class="py-input py-inline-input"
              tiddler=<<secAddInputState>>
              field="todo-name"
              placeholder={{$:/language/projectify/AddTodoToProject/Placeholder}}
              focus="true"
              actions="<$transclude $variable='section-inline-add-actions' sectionName=<<sectionName>> addState=<<secAddInputState>> openState=<<secAddOpenState>>/>"
            />
          </$keyboard>
          <$button
            class="py-btn btn-small btn-primary"
            actions="<$transclude $variable='section-inline-add-actions' sectionName=<<sectionName>> addState=<<secAddInputState>> openState=<<secAddOpenState>>/>"
          >
            <<lingo AddTodo/Caption>>
          </$button>
          <$button class="py-btn btn-small">
            <<lingo Cancel/Caption>>
            <$action-deletetiddler $tiddler=<<secAddOpenState>>/>
          </$button>
        </div>
      <%else%>
        <$button class="tc-btn-invisible py-section-add-trigger" set=<<secAddOpenState>> setTo="yes">
          + <<lingo AddTodo/Caption>>
        </$button>
      <%endif%>
    </div>
  </div>
</$let>
\end

\procedure todo-list(emptyTemplate)
<%if [subfilter<py-has-no-open-todo>] %>
  <%if [all[current]!has[sections]] %>
    <$transclude $tiddler=<<emptyTemplate>>/>
  <%endif%>
<%endif%>

<%if [all[current]has[sections]] %>
  <$let clearSectionOnDrop="yes">
    <%if [all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]!has[section]limit[1]] %>
      <$transclude $variable="todo-list-filtered" subFilter="tag[todo]!has[draft.of]!tag[done]!has[section]"/>
    <%endif%>
  </$let>
  <$list filter="[all[current]get[sections]enlist-input[]]" variable="sectionName">
    <$transclude $variable="todo-list-section" sectionName=<<sectionName>>/>
  </$list>
<%else%>
  <%if [subfilter<py-has-scheduled-todos>] %>
    <label class="py-label"><<lingo Scheduled>></label>
    <$transclude $variable="todo-list-filtered" subFilter=<<py-scheduled-todos-subfilter>>/>
    <%if [subfilter<py-has-unscheduled-todos>] %>
      <label class="py-label"><<lingo OtherTasks>></label>
    <%endif%>
  <%endif%>
  <$transclude $variable="todo-list-filtered" subFilter=<<py-unscheduled-todos-subfilter>>/>
<%endif%>
\end

\procedure todo-list-completed()
<div class="py-todos py-completed-todos">
  <$list
    filter=<<py-completed-todos>>
    template="$:/plugins/mblackman/projectify/ui/todo/TodoItem"
  />
</div>
\end
