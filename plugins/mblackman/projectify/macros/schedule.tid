\procedure py-schedule-overdue()
<$list
  filter=<<py-todos-overdue>>
  template="$:/plugins/mblackman/projectify/ui/todo/TodoItem"
/>
\end

\procedure py-schedule-day(day)
<$list
  filter=<<py-todos-due-on>>
  template="$:/plugins/mblackman/projectify/ui/todo/TodoItem"
/>
\end

\procedure py-schedule-today()
<$list
  filter=<<py-todos-due-today>>
  template="$:/plugins/mblackman/projectify/ui/todo/TodoItem"
  emptyMessage="🌞 {{$:/language/projectify/AllClear}}"
/>
\end
