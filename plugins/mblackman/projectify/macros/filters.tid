\whitespace trim

\function py.descendant-todos(root)
[<root>tagging[]tag[todo]!has[draft.of]]
[<root>tagging[]tag[SubProject]!has[draft.of]tagging[]tag[todo]!has[draft.of]]
[<root>tagging[]tag[SubProject]!has[draft.of]tagging[]tag[SubProject]!has[draft.of]tagging[]tag[todo]!has[draft.of]]
+[unique[]]
\end

\function py.open-descendant-todos(root)
[function[py.descendant-todos],<root>!tag[done]]
\end

\function py.completed-descendant-todos(root)
[function[py.descendant-todos],<root>tag[done]]
\end

\function py.open-blockers()
[all[current]get[blocked-by]enlist-input[]!tag[done]]
\end

\function py.has-open-blocker()
[function[py.open-blockers]limit[1]]
\end

\function py.blocking-todos()
[all[current]listed[blocked-by]tag[todo]!has[draft.of]!tag[done]]
\end

\function py.is-not-future-scheduled()
[all[current]!has[scheduled]] [all[current]days:scheduled[0]] [all[current]!days:scheduled[-1]] +[limit[1]]
\end

\function py.is-actionable-todo()
[all[current]tag[todo]!has[draft.of]!tag[done]!status[waiting]!status[someday]]
:filter[get[blocked-by]enlist-input[]!tag[done]count[]match[0]]
:filter[function[py.is-not-future-scheduled]]
\end

\procedure py-archived-projects()
[all[tiddlers]tag[Project]!has[draft.of]!title[Inbox]tag[done]sort[title]]
\end

\procedure py-active-projects()
[all[tiddlers]tag[Project]!has[draft.of]!title[Inbox]!tag[done]!status[someday]!status[on-hold]]
\end

\procedure py-someday-projects()
[all[tiddlers]tag[Project]!has[draft.of]!title[Inbox]!tag[done]status[someday]] [all[tiddlers]tag[Project]!has[draft.of]!title[Inbox]!tag[done]status[on-hold]]
\end

\procedure py-stalled-projects()
[all[tiddlers]tag[Project]!has[draft.of]!title[Inbox]!tag[done]!status[someday]!status[on-hold]] :filter[function[py.open-descendant-todos],<currentTiddler>count[]match[0]]
\end

\procedure py-all-categories()
[all[tiddlers]tag[$:/plugins/mblackman/projectify/tags/Category]sort[title]] [all[tiddlers]tag[$:/plugins/nico/projectify/tags/Category]sort[title]]
\end

\procedure py-all-contexts()
[all[tiddlers]tag[todo]!has[draft.of]get[context]enlist-input[] unique[]sort[title]]
\end

\procedure py-has-scheduled-todos-in-projects()
[all[tiddlers]tag[todo]!tag[done]!has[draft.of]has[due]limit[1]] [all[tiddlers]tag[todo]!tag[done]!has[draft.of]has[scheduled]limit[1]]
\end

\procedure py-has-active-projects()
[all[tiddlers]tag[Project]!has[draft.of]!tag[done]limit[1]]
\end

\procedure py-has-archived-projects()
[all[tiddlers]tag[Project]!title[Inbox]tag[done]limit[1]]
\end

\procedure py-has-projects()
[all[tiddlers]tag[Project]!title[Inbox]limit[1]]
\end

\procedure py-is-project()
[all[current]tag[Project]] [all[current]tag[SubProject]]
\end

\procedure py-is-not-subproject()
[all[current]!tag[SubProject]]
\end

\procedure py-is-empty-project()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]limit[1]]
\end

\procedure py-has-category()
[all[current]has[category]]
\end

\procedure py-has-todos()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]limit[1]]
\end

\procedure py-has-open-todos()
[function[py.open-descendant-todos],<currentTiddler>limit[1]]
\end

\procedure py-has-no-open-todo()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]count[]match[0]]
\end

\procedure py-has-scheduled-todos()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]has[due]limit[1]]
\end

\procedure py-has-unscheduled-todos()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]!has[due]limit[1]]
\end

\procedure py-has-completed-todos()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]tag[done]limit[1]]
\end

\procedure py-next-open-todo()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]!status[waiting]!status[someday]]
:filter[get[blocked-by]enlist-input[]!tag[done]count[]match[0]]
:filter[function[py.is-not-future-scheduled]]
+[limit[1]]
\end

\procedure py-parallel-open-todos()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]!status[waiting]!status[someday]]
:filter[get[blocked-by]enlist-input[]!tag[done]count[]match[0]]
:filter[function[py.is-not-future-scheduled]]
\end

\procedure py-has-filtered-todos()
[all[tiddlers]subfilter<todoFilter>tag[todo]!has[draft.of]limit[1]]
\end

\procedure py-filtered-todos()
[all[tiddlers]subfilter<todoFilter>tag[todo]!has[draft.of]sort[title]]
\end

\procedure py-open-todos()
[all[tiddlers]tag<currentTiddler>tag[todo]!has[draft.of]!tag[done]]
\end

\procedure py-completed-todos()
[all[tiddlers]tag<currentTiddler>tag[done]!has[draft.of]] :sort:string:reverse[{!!completed}!is[blank]else{!!created}]
\end

\procedure py-todos-due-today()
[all[tiddlers]!tag[done]tag[todo]!has[draft.of]days:due[0]]
[all[tiddlers]!tag[done]tag[todo]!has[draft.of]days:scheduled[0]]
[all[tiddlers]!tag[done]tag[todo]!has[draft.of]!days:scheduled[-1]]
+[unique[]!nsort[priority]]
\end

\procedure py-todos-overdue()
[all[tiddlers]!tag[done]tag[todo]!has[draft.of]!days:due[-1]sort[due]]
\end

\procedure py-todos-due-today-or-overdue()
[all[tiddlers]days:due[0]] [all[tiddlers]!days:due[-1]] [all[tiddlers]days:scheduled[0]] [all[tiddlers]!days:scheduled[-1]] +[!has[draft.of]!tag[done]tag[todo]unique[]sort[due]]
\end

\procedure py-upcoming-due-dates()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]has[due]sort[due]eachday[due]] -[!days:due[-1]]
\end

\procedure py-todos-due-on()
[all[tiddlers]!tag[done]tag[todo]!has[draft.of]sameday:due<day>!nsort[priority]]
\end

\procedure py-has-overdue-todos()
[all[tiddlers]!tag[done]tag[todo]!has[draft.of]!days:due[-1]limit[1]]
\end

\procedure py-has-todos-due-today-or-overdue()
[all[tiddlers]days:due[0]] [all[tiddlers]!days:due[-1]] [all[tiddlers]days:scheduled[0]] [all[tiddlers]!days:scheduled[-1]] +[!has[draft.of]!tag[done]tag[todo]limit[1]]
\end

\procedure py-is-todo()
[all[current]tag[todo]]
\end

\procedure py-is-open()
[all[current]!tag[done]]
\end

\procedure py-is-completed()
[all[current]tag[done]]
\end

\procedure py-is-overdue()
[all[current]!tag[done]!has[draft.of]!days:due[-1]]
\end

\procedure py-is-due-today()
[all[current]!has[draft.of]days:due[0]]
\end

\procedure py-is-due-yesterday()
[all[current]!has[draft.of]days:due[-1]]
\end

\procedure py-is-due-tomorrow()
[all[current]!has[draft.of]days:due[1]]
\end

\procedure py-is-due-later()
[all[current]!has[draft.of]!days:due[1]]
\end

\procedure py-is-scheduled()
[all[current]!has[draft.of]has[due]]
\end

\procedure py-is-not-scheduled()
[all[current]!has[draft.of]!has[due]]
\end

\procedure py-has-start-date()
[all[current]!has[draft.of]has[scheduled]]
\end

\procedure py-has-due-time()
[all[current]!has[draft.of]has[due]] :filter[get[due]format:date[0hh:0mm]!match[23:59]]
\end

\procedure py-has-scheduled-time()
[all[current]!has[draft.of]has[scheduled]] :filter[get[scheduled]format:date[0hh:0mm]!match[23:59]]
\end

\function py.is-12h-time()
[{$:/config/projectify/TimeFormat}match[12h]] [{$:/config/projectify/TimeFormat}!match[24h]then{$:/temp/projectify/LocaleTimeFormat}match[12h]] [{$:/config/projectify/TimeFormat}!match[24h]then{$:/status/projectify/LocaleTimeFormat}match[12h]] +[limit[1]]
\end

\function py.time-template()
[function[py.is-12h-time]then[hh12:0mm am]else[0hh:0mm]]
\end

\procedure py-is-not-overdue()
[all[current]!has[draft.of]] -[!days:due[-1]]
\end

\procedure py-unscheduled-todos-subfilter()
tag[todo]!has[draft.of]!tag[done]!has[due]
\end

\procedure py-scheduled-todos-subfilter()
tag[todo]!has[draft.of]!tag[done]has[due]sort[due]
\end

\procedure py-is-active-subfilter()
!tag[done]
\end

\procedure py-all-projects-and-subprojects-filter()
[tag[Project]] [tag[SubProject]]
\end

\procedure todo-list-drop-tags()
todo [all<actionTiddler>tags[]] -Inbox -[tag[Project]] -[tag[SubProject]] [<tag>]
\end

\procedure project-refile-tags()
todo [all<actionTiddler>tags[]] -Inbox -[tag[Project]] -[tag[SubProject]] [<currentTiddler>]
\end

\procedure py-convert-todo-into-project()
[all[current]tags[]] -Inbox -[tag[Project]] -[tag[SubProject]] -SubProject -Inbox -todo Project
\end

\function py.is-urgent-todo()
[all[current]days:due[0]] [all[current]!days:due[-1]] [all[current]days:due[1]] [all[current]days:due[2]] +[limit[1]]
\end

\function py.is-important-todo()
[all[current]priority[3]] [all[current]priority[2]] +[limit[1]]
\end

\procedure py-matrix-do-first()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]] :filter[function[py.is-important-todo]] :filter[function[py.is-urgent-todo]] +[!nsort[priority]sort[due]]
\end

\procedure py-matrix-schedule()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]] :filter[function[py.is-important-todo]] -[subfilter<py-matrix-do-first>] +[!nsort[priority]sort[due]]
\end

\procedure py-matrix-delegate()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]!priority[3]!priority[2]] :filter[function[py.is-urgent-todo]] +[sort[due]]
\end

\procedure py-matrix-backlog()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]!priority[3]!priority[2]] -[subfilter<py-matrix-delegate>] +[!nsort[priority]sort[title]]
\end

\procedure py-waiting-or-blocked-todos()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]status[waiting]]
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]] :filter[get[blocked-by]enlist-input[]!tag[done]limit[1]]
+[unique[]sort[title]]
\end

\procedure py-someday-todos()
[all[tiddlers]tag[todo]!has[draft.of]!tag[done]status[someday]sort[title]]
\end

\procedure py-recently-completed-todos()
[all[tiddlers]tag[todo]!has[draft.of]tag[done]] :sort:string:reverse[{!!completed}!is[blank]else{!!modified}] +[limit[50]]
\end
