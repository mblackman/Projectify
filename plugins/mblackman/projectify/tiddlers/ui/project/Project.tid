\define lingo-base() $:/language/projectify/

<$list filter=<<py-is-project>> variable="ignore">
  <$list filter=<<py-is-not-subproject>>>
    <div class="py-category-wrapper">
      {{||$:/plugins/mblackman/projectify/ui/buttons/SelectCategory}}
      <$list filter=<<py-is-open>>>
	{{||$:/plugins/mblackman/projectify/ui/buttons/ArchiveProject}}
      </$list>
    </div>
  </$list>
  
  {{||$:/plugins/mblackman/projectify/ui/project/ArchivedProjectBanner}}

  <h2><<lingo Todos>> {{||$:/plugins/mblackman/projectify/images/pie}}</h2>

  <$macrocall
    $name="todo-list"
    emptyTemplate="$:/plugins/mblackman/projectify/ui/welcome/EmptyProject"
  />

  {{||$:/plugins/mblackman/projectify/ui/buttons/ToggleCompletedTodos}}

  <$list filter=<<py-is-open>>>
    <$vars
      stateTiddler=<<qualify "$:/temp/projectify/todo-form">>
      todo-tags="[{!!title}] todo"
      placeholder={{$:/language/projectify/AddTodoToProject/Placeholder}}
    >
      {{||$:/plugins/mblackman/projectify/ui/forms/AddTodo}}
    </$vars>
  </$list>
</$list>
