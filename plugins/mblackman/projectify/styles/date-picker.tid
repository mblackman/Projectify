\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.py-date-picker .py-date-today {
  color: var(--tpc-primary, <<colour primary>>);
}

.py-date-picker .py-date-today svg {
  fill: var(--tpc-primary, <<colour primary>>);
}

.py-date-picker .py-date-clear {
  color: var(--suite-status-danger-fg, #ef4444);
}

.py-date-picker .py-date-clear svg {
  fill: var(--suite-status-danger-fg, #ef4444);
}

.py-date-picker .pika-single {
  margin: 0;
  border: 0;
  padding: 4px 2px;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  color: var(--tpc-foreground, <<colour foreground>>);
  background: transparent;
}

.py-date-picker .pika-lendar {
  margin: 0 !important;
  border: 0;
  width: 100% !important;
  max-width: 100%;
  float: none !important;
  box-sizing: border-box;
}

.py-date-picker .pika-lendar .pika-table {
  margin: 0;
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.py-date-picker .pika-lendar .pika-table th {
  background: transparent;
  font-weight: 600;
  font-size: 11px;
  padding: 2px 0;
  text-align: center;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-date-picker .pika-lendar button,
.py-date-picker .pika-button {
  border-radius: 5px;
  background-color: transparent;
  color: var(--tpc-foreground, <<colour foreground>>);
  text-align: center;
  font-size: 12px;
  box-sizing: border-box;
}

.py-date-picker .pika-button {
  padding: 5px 0 !important;
  width: 100%;
}

.py-date-picker .pika-prev,
.py-date-picker .pika-next {
  padding: 4px;
  width: 20px;
}

.py-date-picker .pika-lendar button:hover,
.py-date-picker .pika-lendar button:active {
  background-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-background, <<colour background>>);
  border-radius: 3px;
}

.py-date-picker .pika-lendar .is-selected .pika-button,
.py-date-picker .pika-lendar .has-event .pika-button {
  background: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
  color: var(--suite-fg-on-accent, #ffffff);
  font-weight: 600;
  box-shadow: none;
  border-radius: 5px;
}

.py-date-picker .pika-label {
  background-color: transparent;
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-date-picker .pika-lendar table th,
.py-date-picker .pika-lendar table td {
  border: 0 none;
}
