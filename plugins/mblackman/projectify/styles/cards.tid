.py-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 20px;
  margin-bottom: 20px;
}

.py-cards > span,
.py-cards > .tc-droppable {
  display: block;
  min-width: 0;
}

.py-card-wrapper {
  /* Default background-color adapts cleanly to light and dark palettes */
  background-color: var(--suite-surface-card, color-mix(in srgb, var(--tpc-tiddler-background, <<colour tiddler-background>>) 93%, var(--tpc-muted-foreground, <<colour muted-foreground>>) 7%));
  border-radius: var(--suite-radius-md, 10px);
  transition: box-shadow ease-in .14s, transform ease-in .14s;
}

.py-cards .tc-dragover .py-card-wrapper .py-card {
  background: var(--suite-surface-dropzone, color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 20%, transparent));
  box-shadow: var(--suite-focus-ring, 0 0 0 4px color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 28%, transparent));
}

.py-card,
a.py-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-decoration: none;
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  border-radius: var(--suite-radius-md, 10px);
  box-shadow: var(--suite-shadow-xs, 0 1px 2px rgba(15, 23, 42, 0.04));
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 20%, transparent));
  padding: var(--suite-card-padding-lg, 18px 20px);
  min-height: 150px;
  font-size: .9em;
  box-sizing: border-box;
  gap: 8px;
}

/* When a category sets a custom color (--py-card-bg), blend it subtly into --suite-surface-card
   so project cards remain cohesive across both light and dark palettes. */
.py-card-wrapper.py-card-custom-bg {
  background-color: color-mix(in srgb, var(--suite-surface-card, var(--tpc-tiddler-background, <<colour tiddler-background>>)) 86%, var(--py-card-bg) 14%);
}

.py-card-wrapper.py-card-custom-bg .py-card {
  border-color: color-mix(in srgb, var(--suite-border-subtle, <<colour table-border>>) 70%, var(--py-card-bg) 30%);
}

.py-card-wrapper.py-card-custom-bg .py-card .py-project-category {
  background: color-mix(in srgb, var(--suite-surface-subtle, <<colour tiddler-background>>) 75%, var(--py-card-bg) 25%);
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
}

.py-card-wrapper:hover {
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 30%, transparent);
}

.py-card-head {
  line-height: 1.3em;
}

.py-card .py-card-head h3 {
  font-weight: bold;
  font-size: 1em;
  line-height: 1.25em;
  margin: 0;
  margin-right: 18px;
  color: var(--tpc-tiddler-title-foreground, var(--tpc-foreground, <<colour foreground>>));
}

.py-card .py-card-options {
  position: absolute;
  top: 4px;
  right: 8px;
}

.py-card .py-description {
  color: color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 82%, transparent);
  font-size: .9em;
  line-height: 1.35em;
  margin-top: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
}

.py-card .py-project-infos {
  color: color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 85%, transparent);
  font-size: .9em;
  display: flex;
  align-items: center;
  gap: 5px;
}

.py-card .py-project-category {
  font-size: .9em;
  font-weight: bold;
  text-align: center;
  padding: 2px 4px;
  margin-bottom: -18px;
  margin-left: -20px;
  margin-right: -20px;
  background: color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 10%, transparent);
  border-bottom-left-radius: 8px;
  border-bottom-right-radius: 8px;
}
