  box-sizing: border-box;
}

.py-recur-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
  width: 100%;
  box-sizing: border-box;
}

.tc-drop-down.py-drop-down .py-recur-chips .py-recur-chip {
  flex: 1 1 calc(33.333% - 3px);
}

.tc-drop-down.py-drop-down .py-time-presets .py-time-chip,
.tc-drop-down.py-drop-down .py-recur-chips .py-time-chip {
  justify-content: center;
  text-align: center;
  font-size: 10.5px;
  font-weight: 600;
  line-height: 1.25;
  min-height: 28px;
  padding: 3px 4px;
  border-radius: 6px;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 32%, transparent);
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 8%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
  white-space: nowrap;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tc-drop-down.py-drop-down .py-time-presets .py-time-chip:hover,
.tc-drop-down.py-drop-down .py-time-presets .py-time-chip.py-active,
.tc-drop-down.py-drop-down .py-recur-chips .py-time-chip:hover,
.tc-drop-down.py-drop-down .py-recur-chips .py-time-chip.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-primary, <<colour primary>>);
}

.py-time-custom-row {
  display: flex;
  align-items: center;
  gap: 4px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.tc-drop-down.py-drop-down .py-time-custom-row .py-time-step-btn {
  flex: 0 0 auto;
  width: auto;
  min-height: 30px;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.2;
  justify-content: center;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 32%, transparent);
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 8%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.tc-drop-down.py-drop-down .py-time-custom-row .py-time-step-btn:hover {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 14%, transparent);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-primary, <<colour primary>>);
}

.tc-drop-down.py-drop-down input.py-input.py-time-input {
