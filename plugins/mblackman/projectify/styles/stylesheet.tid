tags: $:/tags/Stylesheet
title: $:/plugins/mblackman/projectify/styles/stylesheet
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.py-projects-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.py-projects-heading h2 {
  margin: 0;
  display: inline-block;
}

@media (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-projects-heading {
    display: block;
  }

  .py-projects-heading .py-title {
    margin-bottom: 20px;
  }
}

.py-projects-heading > button {
  display: inline-block;
  margin-left: 5px;
}

.tc-titlebar .py-checkbox svg {
  width: 26px;
  height: 26px;
  fill: var(--tpc-tiddler-controls-foreground, <<colour tiddler-controls-foreground>>);
}

.tc-titlebar .py-checkbox .done svg {
  width: 26px;
  height: 26px;
  fill: #2da562;
}

.py-reorder-projects:not([hidden]) {
  display: block;
}

.py-projects, .py-todos {
  padding-left: 0;
}

.py-projects .py-project,
.py-todos .tc-menu-list-item {
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
}

.py-projects,
.py-todos .tc-menu-list-item:first-child {
  border-top: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
}

.py-todo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 0;
}

.py-todo-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.py-todo-main label {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.py-todo-main .tc-tiddlylink {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.py-project {
  list-style: none;
  padding: 5px 0;
}

.py-project a {
  font-weight: bold;
}

.py-project .py-project-infos {
  font-size: .8em;
  line-height: 1em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  margin-left: 20px;
}

.py-project .py-project-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.py-project .py-project-heading .py-project-category {
  font-size: .9em;
  white-space: nowrap;
}

/* Align the completed todos with the non-completed ones that have a drag handle */
.py-completed-todos .py-todo .py-checkbox {
  padding-left: 22px;
}

.py-todo .tc-tiddlylink:hover {
  text-decoration: none;
}

.py-todo .py-todo-actions {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.py-todo .py-btn.py-priority {
  border: none;
}

.py-todo .py-project-link {
  font-size: .8em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-todo .py-todo-text-icon {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  margin-left: 4px;
}

.py-todo.py-completed a {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  text-decoration: line-through;
}

.py-todo-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
  margin-bottom: 14px;
}

.py-todo-heading .py-btn {
  font-size: .9em;
  padding: .3em .9em;
}

.py-todo-actions .py-btn,
.py-todo .py-btn.py-priority {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  padding: 4px 8px;
  border-radius: 4px;
}

.py-due-date.py-overdue {
  color: #ffffff;
  fill: #ffffff;
  background: #e73939;
  border-color: #e73939;
  font-weight: bold;
}

.py-due-date.py-due-today {
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
  border-color: var(--tpc-primary, <<colour primary>>);
}

.py-todo .py-todo-actions .py-btn {
  font-size: .8em;
  margin-left: 6px;
}

@media (min-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-todo .py-todo-actions .py-btn.py-not-scheduled,
  .py-todo .py-todo-actions .py-btn.py-priority- {
    opacity: 0;
    transition: opacity ease-in .14s;
  }

  .py-todo:hover .py-todo-actions .py-btn,
  .py-todo:focus-within .py-todo-actions .py-btn {
    opacity: 1 !important;
  }
}

.py-projects .tc-droppable.tc-dragover {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 18%, transparent);
  display: block;
}

.py-tabs.tc-tab-buttons button {
  font-weight: bold;
  font-size: 1.2em;
  border: 0;
  padding: .6em .8em .4em .8em;
  background: transparent;
  cursor: pointer;
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
}

@media (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-tabs.tc-tab-buttons button {
    font-size: .8em;
    padding: 8px;
  }

  .py-tabs.tc-tab-buttons button svg {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0 auto 6px auto;
  }
}

.py-tabs.tc-tab-buttons button.tc-tab-selected {
  border: 0;
  border-bottom: 4px solid var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
}

.py-scheduled-drop-down h4 {
  margin: 5px 10px;
  color: var(--tpc-foreground, <<colour foreground>>);
  font-weight: bold;
}

.py-scheduled-drop-down .clear {
  margin: 5px 10px;
}

.tc-drop-down.py-drop-down {
  min-width: 200px;
}

.tc-drop-down.py-drop-down .tc-btn-invisible,
.tc-drop-down.py-drop-down a.tc-tiddlylink {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  font-size: 14px;
  line-height: 2em;
  padding: 2px 10px;
  text-align: left;
}

.tc-drop-down.py-drop-down .tc-btn-invisible svg {
  margin-right: 6px;
  flex-shrink: 0;
}

.tc-drop-down.py-drop-down hr {
  margin: 4px 0;
  padding: 0;
  border: 0;
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 30%, transparent);
}

.tc-drop-down .py-priorities {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.tc-drop-down .py-priorities .tc-btn-invisible {
  width: auto;
  justify-content: center;
  text-align: center;
}

.py-priority-3, .py-priority-3 svg,
.py-drop-down .py-priority-3,
.py-drop-down .py-priority-3 svg,
.py-btn.py-priority-3 {
  fill: #e73939;
  color: #e73939;
}

.py-priority-2, .py-priority-2 svg,
.py-drop-down .py-priority-2,
.py-drop-down .py-priority-2 svg,
.py-btn.py-priority-2 {
  fill: #e77a39;
  color: #e77a39;
}

.py-priority-1, .py-priority-1 svg,
.py-drop-down .py-priority-1,
.py-drop-down .py-priority-1 svg,
.py-btn.py-priority-1 {
  fill: #24cd5e;
  color: #24cd5e;
}

.py-project-category-manager-table {
  width: 100%;
}

.py-project-category-manager-table td {
  padding: 4px;
}

.py-project-category-manager-table input {
  width: 100%;
}

.py-project-category-manager-table input[type="color"] {
  width: 50px;
  padding: 3px;
}

/* Multi-status checkbox states */
.py-checkbox .py-state-in-progress {
  color: var(--tpc-primary, <<colour primary>>);
  display: inline-flex;
}

.py-checkbox .py-state-waiting {
  color: #e77a39;
  display: inline-flex;
}

.py-checkbox .py-state-someday {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  display: inline-flex;
}

.py-checkbox .py-state-cancelled {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  display: inline-flex;
}

/* Status selector in dropdowns and headings */
.py-status-selector {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 4px;
  padding: 2px 4px;
}

.tc-drop-down .py-status-selector .tc-btn-invisible,
.py-todo-heading .py-status-selector .tc-btn-invisible {
  width: auto;
  padding: 4px 6px;
  border-radius: 4px;
  justify-content: center;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
}

.py-status-selector .py-status-btn.py-active,
.py-status-selector .py-status-btn:hover {
  color: var(--tpc-primary, <<colour primary>>);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 14%, transparent);
}

/* Date picker tabs, compact quick-dates grid, and recurrence row */
.py-date-mode-tabs {
  display: flex;
  gap: 4px;
  padding: 4px 8px;
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 25%, transparent);
  margin-bottom: 2px;
}

.tc-drop-down.py-drop-down .py-date-mode-tabs .py-date-mode-tab {
  width: auto;
  flex: 1 1 0;
  justify-content: center;
  font-size: 12px;
  line-height: 1.5;
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.tc-drop-down.py-drop-down .py-date-mode-tabs .py-date-mode-tab.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
  font-weight: 600;
}

.py-quick-dates {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2px;
  padding: 2px 6px;
}

.tc-drop-down.py-drop-down .py-quick-dates .tc-btn-invisible {
  font-size: 12.5px;
  line-height: 1.6em;
  padding: 3px 6px;
  border-radius: 4px;
  white-space: nowrap;
}

.tc-drop-down.py-drop-down .py-quick-dates .py-calendar-toggle {
  grid-column: 1 / -1;
  justify-content: center;
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 10%, transparent);
  margin-top: 2px;
}

.tc-drop-down.py-drop-down .py-quick-dates .py-calendar-toggle.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 15%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
}

.py-recur-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 4px 10px;
}

.py-inline-label {
  font-size: 12px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin: 0;
}

.py-menu-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2px;
  padding: 2px 4px;
}

.tc-drop-down.py-drop-down .py-menu-actions-grid .tc-btn-invisible {
  font-size: 12.5px;
  line-height: 1.6em;
  padding: 3px 6px;
  border-radius: 4px;
}

.tc-drop-down.py-drop-down .py-menu-actions-grid .tc-btn-invisible:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.tc-drop-down.py-todo-actions-drop-down {
  width: 245px;
  max-width: calc(100vw - 24px);
  max-height: 80vh;
  overflow-y: auto;
}

.py-recur-picker,
.py-context-picker,
.py-dependency-picker,
.py-drop-down-section {
  padding: 4px 8px;
}

.py-drop-down-section .py-label,
.py-dependency-picker .py-label {
  display: block;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  padding: 2px 4px 4px 4px;
}

.tc-drop-down.py-drop-down .tc-btn-invisible.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 14%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
  font-weight: 600;
  border-radius: 4px;
}

.py-inline-section-add input.py-input {
  width: 170px;
  padding: 4px 8px;
  font-size: 13px;
}

.py-recur-label {
  font-size: 12px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 4px;
}

.py-recur-options,
.py-context-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.tc-drop-down.py-drop-down .py-recur-options .py-recur-chip,
.tc-drop-down.py-drop-down .py-context-chips .py-context-chip {
  width: auto;
  font-size: 11px;
  line-height: 1.4;
  padding: 2px 7px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 35%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.tc-drop-down.py-drop-down .py-recur-options .py-recur-chip.py-active,
.tc-drop-down.py-drop-down .py-context-chips .py-context-chip.py-active {
  background: var(--tpc-primary, <<colour primary>>);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-background, <<colour background>>);
}

/* Badges & Context pills on todo items */
.py-badge,
.py-context-pill {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 0.75em;
  padding: 1px 6px;
  border-radius: 999px;
  margin-left: 4px;
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 15%, transparent);
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  white-space: nowrap;
}

.py-badge-blocked,
a.py-badge-blocked {
  color: #e73939;
  fill: #e73939;
  background: color-mix(in srgb, #e73939 14%, transparent);
  border: 1px solid color-mix(in srgb, #e73939 28%, transparent);
  text-decoration: none;
  max-width: 155px;
}

a.py-badge-blocked:hover {
  background: color-mix(in srgb, #e73939 22%, transparent);
  text-decoration: none;
}

.py-badge-blocked-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-badge-blocked,
  a.py-badge-blocked {
    max-width: 110px;
  }
}

.py-badge-blocking {
  color: #e77a39;
  fill: #e77a39;
  background: color-mix(in srgb, #e77a39 14%, transparent);
}

.py-select-blocker {
  max-width: 135px;
  text-overflow: ellipsis;
}

.py-select-full {
  width: 100%;
  max-width: 220px;
}

/* Dependency Banners in TodoHeading */
.py-dependency-banners {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
}

.py-dependency-banner {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 0.9em;
}

.py-banner-blocked {
  background: color-mix(in srgb, #e73939 10%, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  border: 1px solid color-mix(in srgb, #e73939 30%, transparent);
}

.py-banner-blocking {
  background: color-mix(in srgb, #e77a39 10%, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  border: 1px solid color-mix(in srgb, #e77a39 30%, transparent);
}

.py-dependency-banner-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-weight: 600;
}

.py-banner-blocked .py-dependency-banner-label {
  color: #e73939;
  fill: #e73939;
}

.py-banner-blocking .py-dependency-banner-label {
  color: #e77a39;
  fill: #e77a39;
}

.py-dependency-banner-items {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1 1 auto;
}

.py-dependency-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 28%, transparent);
  font-weight: 500;
}

.py-dependency-clear {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  padding: 2px 4px;
  border-radius: 4px;
  cursor: pointer;
  opacity: 0.7;
}

.py-dependency-clear:hover {
  opacity: 1;
}

.py-context-pill {
  color: var(--tpc-primary, <<colour primary>>);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent);
}

/* Inline Sub-tasks & Inline Edit */
.py-todo-check-btn {
  display: inline-flex;
  align-items: center;
  padding: 0;
  margin: 0;
  cursor: pointer;
}

.py-subtask-toggle {
  display: inline-flex;
  align-items: center;
  margin-left: 6px;
  padding: 2px 4px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  border-radius: 4px;
  cursor: pointer;
}

.py-subtask-toggle:hover {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 15%, transparent);
}

.py-subtasks-indent {
  margin-left: 24px;
  padding-left: 10px;
  border-left: 2px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
  margin-bottom: 6px;
}

.py-inline-subtask-form,
.py-inline-edit-row,
.py-inline-section-add {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 4px;
}

input.py-input.py-subtask-input,
input.py-input.py-inline-input {
  padding: 4px 8px;
  font-size: 0.9em;
  width: 240px;
}

/* Project Toolbar, View Switcher, and Sections */
.py-project-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0 8px 0;
}

.py-project-toolbar h2 {
  margin: 0;
}

.py-project-toolbar-controls {
  display: flex;
  align-items: center;
  gap: 6px;
}

.py-view-switcher {
  display: inline-flex;
  gap: 4px;
}

.py-btn.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
  font-weight: 600;
}

.py-project-section {
  margin-top: 14px;
}

.py-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
  border-bottom: 2px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 28%, transparent);
  margin-bottom: 4px;
}

.py-section-title-drop {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 auto;
}

.py-section-title {
  font-weight: 700;
  font-size: 0.95em;
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
}

.py-section-delete {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  opacity: 0.5;
  cursor: pointer;
}

.py-section-delete:hover {
  opacity: 1;
}

/* Kanban Board View */
.py-board {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 12px;
  margin: 12px 0 18px 0;
  align-items: start;
}

.py-board-column {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 8%, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
  border-radius: 8px;
  padding: 10px;
  min-height: 160px;
}

.py-board-column-inner.tc-droppable.tc-dragover {
  outline: 2px dashed var(--tpc-primary, <<colour primary>>);
  border-radius: 6px;
}

.py-board-column-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
}

.py-board-column-title {
  font-weight: 700;
  font-size: 0.9em;
}

.py-board-cards .py-todo-item-wrapper {
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
  border-radius: 6px;
  padding: 4px 8px;
  margin-bottom: 6px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

/* Eisenhower Matrix & Review Dashboards */
.py-matrix-grid,
.py-review-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 12px 0;
}

@media (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-matrix-grid,
  .py-review-grid {
    grid-template-columns: 1fr;
  }
}

.py-matrix-quadrant,
.py-review-panel {
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 24%, transparent);
  border-radius: 8px;
  padding: 12px;
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
}

.py-matrix-quadrant-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8px;
}

.py-matrix-quadrant-header h4,
.py-review-panel h3 {
  margin: 0;
}

.py-matrix-subtitle {
  font-size: 0.8em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-quadrant-do-first {
  border-top: 3px solid #e73939;
}

.py-quadrant-schedule {
  border-top: 3px solid var(--tpc-primary, <<colour primary>>);
}

.py-quadrant-delegate {
  border-top: 3px solid #e77a39;
}

.py-quadrant-backlog {
  border-top: 3px solid var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-empty-quadrant {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  font-size: 0.9em;
  padding: 8px 0;
}

/* Context filter bar, Today heading, & Presets */
.py-context-filter-bar,
.py-preset-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 8px 0 12px 0;
}

.py-today-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.py-quick-capture-toolbar {
  justify-content: space-between;
  flex-wrap: wrap;
}

.py-select-compact {
  font-size: 0.85em;
  padding: 3px 8px;
  border-radius: 1em;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 40%, transparent);
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  color: var(--tpc-foreground, <<colour foreground>>);
}

/* Modern Help & Reference Documentation Grid */
.py-doc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
  margin: 12px 0 20px 0;
}

.py-doc-card {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 7%, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
  border-radius: 8px;
  padding: 12px 14px;
}

.py-doc-card h4 {
  margin: 0 0 6px 0;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.95em;
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
  fill: var(--tpc-primary, <<colour primary>>);
}

.py-doc-card p {
  margin: 0;
  font-size: 0.85em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  line-height: 1.4;
}

/* Smart Quick-Add Autocomplete Menu */
.py-quick-input-wrapper {
  position: relative;
  width: 100%;
}

.py-inline-subtask-form .py-quick-input-wrapper {
  width: auto;
}

.py-autocomplete-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  z-index: 1200;
  min-width: 240px;
  max-width: min(360px, calc(100vw - 32px));
  max-height: 220px;
  overflow-y: auto;
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  color: var(--tpc-foreground, <<colour foreground>>);
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 30%, transparent);
  border-radius: 8px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
  padding: 4px;
}

.py-autocomplete-menu[hidden] {
  display: none !important;
}

.py-autocomplete-menu .tc-btn-invisible.py-autocomplete-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  box-sizing: border-box;
  padding: 5px 8px;
  border-radius: 5px;
  font-size: 13px;
  line-height: 1.4;
  text-align: left;
  color: var(--tpc-foreground, <<colour foreground>>);
  cursor: pointer;
}

.py-autocomplete-menu .tc-btn-invisible.py-autocomplete-item:hover,
.py-autocomplete-menu .tc-btn-invisible.py-autocomplete-item.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 15%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
}

.py-autocomplete-label {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.py-autocomplete-prefix {
  color: var(--tpc-primary, <<colour primary>>);
  font-weight: 700;
  margin-right: 1px;
}

.py-autocomplete-badge {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 14%, transparent);
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  white-space: nowrap;
  flex-shrink: 0;
}

/* Push Reminders & Focus Timers */
.py-reminder-section {
  padding: 4px 10px 6px 10px;
}

.py-reminder-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-bottom: 4px;
}

.tc-drop-down.py-drop-down .py-reminder-header .py-reminder-cancel {
  width: auto;
  font-size: 11px;
  line-height: 1.3;
  padding: 1px 6px;
  border-radius: 4px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
}

.tc-drop-down.py-drop-down .py-reminder-header .py-reminder-cancel:hover {
  color: #e73939;
  background: color-mix(in srgb, #e73939 12%, transparent);
}

.py-reminder-chips {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4px;
}

.tc-drop-down.py-drop-down .py-reminder-chips .py-reminder-chip {
  justify-content: center;
  text-align: center;
  font-size: 11.5px;
  font-weight: 600;
  line-height: 1.4;
  min-height: 28px;
  padding: 4px 6px;
  border-radius: 6px;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 32%, transparent);
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 8%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.tc-drop-down.py-drop-down .py-reminder-chips .py-reminder-chip:hover {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-primary, <<colour primary>>);
}

.py-review-toolbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 6px;
  margin: 4px 0 10px 0;
}

.py-push-status-active {
  border-color: color-mix(in srgb, #2da562 45%, transparent);
}
