  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
}

.py-dependency-banner {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 0.9em;
}

.py-banner-blocked {
  background: var(--suite-status-danger-bg);
  border: 1px solid var(--suite-status-danger-border);
}

.py-banner-blocking {
  background: var(--suite-status-warning-bg);
  border: 1px solid var(--suite-status-warning-border);
}

.py-dependency-banner-label {
