  }
}

.py-badge-blocking {
  color: var(--suite-status-warning-fg);
  fill: var(--suite-status-warning-fg);
  background: var(--suite-status-warning-bg);
  border: 1px solid var(--suite-status-warning-border);
}

.py-select-blocker {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  text-overflow: ellipsis;
}

.py-select-full {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

