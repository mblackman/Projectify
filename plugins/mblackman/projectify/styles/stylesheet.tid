/* Date picker tabs, compact quick-dates grid, and recurrence row */
.py-date-mode-tabs {
  display: flex;
  gap: 3px;
  padding: 2px 6px 3px 6px;
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 20%, transparent);
  margin-bottom: 2px;
}

.tc-drop-down.py-drop-down .py-date-mode-tabs .py-date-mode-tab {
  width: auto;
  flex: 1 1 0;
  justify-content: center;
  font-size: 11.5px;
  line-height: 1.35;
  padding: 2px 4px;
