/* Standalone-safe fallback contract (specificity 0,0,0 via :where).
   Automatically overridden when Slipstream ($:/plugins/mblackman/slipstream) is active. */
:where(:root, .tc-page-container) {
  --suite-bg-canvas: var(--mn-bg-app, var(--tpc-page-background, <<colour page-background>>));
  --suite-surface-primary: var(--mn-bg-surface, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  --suite-surface-card: var(--mn-bg-card, color-mix(in srgb, var(--tpc-tiddler-background, <<colour tiddler-background>>) 96.5%, var(--tpc-foreground, <<colour foreground>>) 3.5%));
  --suite-surface-subtle: var(--mn-bg-subtle, color-mix(in srgb, var(--tpc-tiddler-background, <<colour tiddler-background>>) 93%, var(--tpc-foreground, <<colour foreground>>) 7%));
  --suite-surface-elevated: var(--mn-bg-elevated, color-mix(in srgb, var(--tpc-tiddler-background, <<colour tiddler-background>>) 90%, var(--tpc-foreground, <<colour foreground>>) 10%));
  --suite-surface-input: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  --suite-surface-hover: var(--mn-bg-hover, color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 5.5%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  --suite-surface-active: var(--mn-bg-active, color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 9%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  --suite-surface-selected: var(--mn-accent-soft, color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  --suite-surface-dropzone: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 8%, var(--suite-surface-subtle));

  --suite-fg-primary: var(--mn-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  --suite-fg-secondary: var(--mn-fg-secondary, color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 72%, var(--tpc-muted-foreground, <<colour muted-foreground>>) 28%));
  --suite-fg-muted: var(--mn-fg-muted, color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 58%, var(--tpc-muted-foreground, <<colour muted-foreground>>) 42%));
  --suite-fg-on-accent: #ffffff;

  --suite-border-hairline: var(--mn-border-hairline, color-mix(in srgb, var(--suite-fg-primary) 7%, transparent));
  --suite-border-subtle: var(--mn-border-subtle, color-mix(in srgb, var(--suite-fg-primary) 12%, transparent));
  --suite-border-strong: var(--mn-border-strong, color-mix(in srgb, var(--suite-fg-primary) 22%, transparent));

  --suite-radius-xs: 6px;
  --suite-radius-sm: 8px;
  --suite-radius-md: 10px;
  --suite-radius-lg: 14px;
  --suite-radius-xl: 18px;
  --suite-radius-pill: 9999px;

  --suite-shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
  --suite-shadow-sm: var(--mn-shadow-card, 0 2px 8px -2px rgba(15, 23, 42, 0.06), 0 1px 3px -1px rgba(15, 23, 42, 0.04));
  --suite-shadow-md: 0 6px 16px -4px rgba(15, 23, 42, 0.10), 0 2px 6px -1px rgba(15, 23, 42, 0.05);
  --suite-shadow-lg: var(--mn-shadow-popover, 0 12px 32px -4px rgba(15, 23, 42, 0.16), 0 4px 12px -2px rgba(15, 23, 42, 0.08));
  --suite-scrim: var(--mn-scrim, rgba(15, 23, 42, 0.45));

  --suite-space-1: 0.25rem;
  --suite-space-2: 0.5rem;
  --suite-space-3: 0.75rem;
  --suite-space-4: 1rem;
  --suite-space-5: 1.25rem;
  --suite-space-6: 1.5rem;
  --suite-space-8: 2rem;

  --suite-card-padding-sm: 0.625rem 0.75rem;
  --suite-card-padding-md: 0.875rem 1rem;
  --suite-card-padding-lg: 1.125rem 1.25rem;
  --suite-card-gap: 0.75rem;
  --suite-section-gap: 1.25rem;
  --suite-row-padding-y: 0.5rem;

  --suite-control-height-sm: 30px;
  --suite-control-height-md: 36px;
  --suite-control-height-lg: 44px;
  --suite-touch-target: 36px;

  --suite-font-sans: var(--mn-font-sans, -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif);
  --suite-font-mono: var(--mn-font-mono, "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace);

  --suite-text-xs: 0.75rem;
  --suite-text-sm: 0.84rem;
  --suite-text-base: 0.9375rem;
  --suite-text-lg: 1.125rem;
  --suite-text-xl: 1.375rem;

  --suite-accent: var(--mn-accent, var(--tpc-primary, <<colour primary>>));
  --suite-accent-hover: var(--mn-accent-hover, color-mix(in srgb, var(--suite-accent) 86%, var(--suite-fg-primary)));
  --suite-accent-bg: var(--mn-accent-soft, color-mix(in srgb, var(--suite-accent) 12%, var(--suite-surface-primary)));
  --suite-accent-border: color-mix(in srgb, var(--suite-accent) 30%, transparent);

  --suite-status-success-accent: #10b981;
  --suite-status-success-fg: color-mix(in srgb, #059669 82%, var(--suite-fg-primary));
  --suite-status-success-bg: color-mix(in srgb, #10b981 13%, var(--suite-surface-primary));
  --suite-status-success-border: color-mix(in srgb, #10b981 32%, transparent);

  --suite-status-warning-accent: #f59e0b;
  --suite-status-warning-fg: color-mix(in srgb, #d97706 82%, var(--suite-fg-primary));
  --suite-status-warning-bg: color-mix(in srgb, #f59e0b 14%, var(--suite-surface-primary));
  --suite-status-warning-border: color-mix(in srgb, #f59e0b 35%, transparent);

  --suite-status-danger-accent: var(--mn-danger, var(--tpc-alert-highlight, #ef4444));
  --suite-status-danger-fg: color-mix(in srgb, var(--suite-status-danger-accent) 85%, var(--suite-fg-primary));
  --suite-status-danger-bg: color-mix(in srgb, var(--suite-status-danger-accent) 12%, var(--suite-surface-primary));
  --suite-status-danger-border: color-mix(in srgb, var(--suite-status-danger-accent) 32%, transparent);

  --suite-status-info-accent: #3b82f6;
  --suite-status-info-fg: color-mix(in srgb, #2563eb 82%, var(--suite-fg-primary));
  --suite-status-info-bg: color-mix(in srgb, #3b82f6 12%, var(--suite-surface-primary));
  --suite-status-info-border: color-mix(in srgb, #3b82f6 30%, transparent);

  --suite-focus-ring: 0 0 0 3px color-mix(in srgb, var(--suite-accent) 28%, transparent);
}

:where([data-suite-density="compact"], .suite-density-compact) {
  --suite-row-padding-y: 0.25rem;
  --suite-card-padding-sm: 0.45rem 0.625rem;
  --suite-card-gap: 0.5rem;
}

@media (max-width: 640px), (pointer: coarse) {
  :where(:root, .tc-page-container) {
    --suite-control-height-sm: 36px;
    --suite-control-height-md: 44px;
    --suite-touch-target: 44px;
  }
}

.py-projects-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.py-projects-heading .py-title {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.py-projects-heading h2 {
  margin: 0;
  display: inline-block;
}

@media (max-width: 640px), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-projects-heading {
    margin-bottom: 10px;
  }
}

.py-projects-heading > button {
  display: inline-block;
  margin-left: 5px;
}

.tc-titlebar .py-checkbox svg {
  width: 26px;
  height: 26px;
  fill: var(--tpc-tiddler-controls-foreground, <<colour tiddler-controls-foreground>>);
}

.tc-titlebar .py-checkbox .done svg {
  width: 26px;
  height: 26px;
  fill: var(--suite-status-success-accent);
}

.py-reorder-projects:not([hidden]) {
  display: block;
}

.py-reorder-project-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 0;
}

.py-projects, .py-todos {
  padding-left: 0;
}

.py-todos:not(.py-board-cards) {
  container-type: inline-size;
}

.py-projects .py-project,
.py-todos .tc-menu-list-item {
  border-bottom: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent));
}

.py-projects,
.py-todos .tc-menu-list-item:first-child {
  border-top: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent));
}

.py-todo {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: var(--suite-row-padding-y, 8px) 0;
}

.py-todo > .py-drag-handle {
  margin-top: -1px;
  flex-shrink: 0;
}

@media (hover: hover) {
  .py-todos:not(.py-board-cards) .py-todo > .py-drag-handle {
    opacity: 0.25;
    transition: opacity 0.14s ease, background-color 0.14s ease, color 0.14s ease;
  }

  .py-todos:not(.py-board-cards) .py-todo:hover > .py-drag-handle,
  .py-todos:not(.py-board-cards) .py-todo:focus-within > .py-drag-handle {
    opacity: 1;
  }
}

.py-todo > .py-todo-check-btn {
  margin: -7px -5px -7px -5px;
  padding: 9px 7px;
  border-radius: 8px;
  flex-shrink: 0;
}

@media (max-width: 640px), (pointer: coarse), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-todo > .py-todo-check-btn {
    margin: -11px -7px -11px -7px;
    padding: 13px 11px;
  }
}

.py-todo-body {
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1 1 0%;
  min-width: 0;
}

.py-todo-title-row {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  min-width: 0;
  line-height: 1.4;
}

@container (min-width: 600px) {
  .py-todos:not(.py-board-cards) .py-todo-body {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 5px 12px;
  }

  .py-todos:not(.py-board-cards) .py-todo-title-row {
    flex: 1 1 240px;
    align-items: center;
  }
}

@media (min-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-todos:not(.py-board-cards) .py-todo-body {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 5px 12px;
  }

  .py-todos:not(.py-board-cards) .py-todo-title-row {
    flex: 1 1 240px;
    align-items: center;
  }
}

.py-todo-link,
a.py-todo-link {
  display: inline;
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
  line-height: 1.4;
  font-weight: 500;
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-todo-inline-icon,
.py-todo-text-icon {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  margin-left: 5px;
}

.py-todo-text-icon svg,
.tc-tiddler-frame .py-todo-text-icon svg {
  width: 13px;
  height: 13px;
  max-width: none;
  flex-shrink: 0;
  display: block;
}

.py-todo-menu {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 2px;
  margin-left: 2px;
  margin-top: -1px;
}

.py-todo-menu .py-btn {
  padding: 4px 6px;
  min-width: 28px;
  min-height: 28px;
  justify-content: center;
  border-radius: 6px;
  border-color: transparent;
  background: transparent;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-todo-menu .py-btn.py-todo-quick-edit svg,
.tc-tiddler-frame .py-todo-menu .py-btn.py-todo-quick-edit svg {
  width: 13px;
  height: 13px;
  max-width: none;
  display: block;
}

@media (hover: hover) {
  .py-todo-menu .py-btn.py-todo-quick-edit {
    opacity: 0;
    transition: opacity 0.14s ease, background-color 0.14s ease, color 0.14s ease;
  }

  .py-todo:hover .py-todo-menu .py-btn.py-todo-quick-edit,
  .py-todo:focus-within .py-todo-menu .py-btn.py-todo-quick-edit {
    opacity: 1;
  }
}

@media (max-width: 640px), (pointer: coarse), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-todo-menu .py-btn.py-todo-quick-edit {
    display: none;
  }

  .py-todo-menu .py-btn {
    min-width: var(--suite-touch-target, 44px);
    min-height: var(--suite-touch-target, 44px);
    margin: -6px -4px;
    padding: 8px;
  }
}

.py-todo-menu .py-btn:hover,
.py-todo-menu .py-btn:focus-visible {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 14%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
  fill: var(--tpc-foreground, <<colour foreground>>);
}

.py-project {
  list-style: none;
  padding: 5px 0;
}

.py-project a {
  font-weight: bold;
}

.py-project .py-project-infos {
  font-size: .8em;
  line-height: 1em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  margin-left: 20px;
}

.py-project .py-project-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.py-project .py-project-heading .py-project-category {
  font-size: .9em;
  white-space: nowrap;
}

/* Align the completed todos with the non-completed ones that have a drag handle */
.py-completed-todos .py-todo > .py-todo-check-btn {
  margin-left: 22px;
}

.py-todo .tc-tiddlylink:hover {
  text-decoration: none;
}

.py-todo .py-todo-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
  min-width: 0;
  max-width: 100%;
}

.py-todo .py-todo-actions:empty {
  display: none;
}

.py-todo .py-todo-actions svg,
.tc-tiddler-frame .py-todo .py-todo-actions svg {
  width: 12px;
  height: 12px;
  max-width: none;
  flex-shrink: 0;
  display: block;
}

.py-todo .py-btn.py-priority {
  border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
  background: color-mix(in srgb, currentColor 10%, transparent);
}

.py-todo .py-project-link {
  display: inline-flex;
  align-items: center;
  font-size: .75em;
  line-height: 1.3;
  padding: 2px 8px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 13%, transparent);
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  text-decoration: none;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.py-todo .py-todo-text-icon {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  margin-left: 4px;
}

.py-todo.py-completed a.py-todo-link {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  text-decoration: line-through;
}

.py-todo-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
  margin-bottom: 14px;
}

.py-todo-heading .py-btn {
  font-size: .9em;
  padding: .3em .9em;
}

.py-todo-actions .py-btn:not(.btn-primary):not(.py-overdue):not(.py-due-today),
.py-todo .py-btn.py-priority {
  color: color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 72%, var(--tpc-muted-foreground, <<colour muted-foreground>>));
  fill: currentColor;
  padding: 2px 7px;
  border-radius: 999px;
}

.py-todo-actions .py-btn.py-due-date {
  padding: 2px 7px;
  border-radius: 999px;
  font-variant-numeric: tabular-nums;
}

.py-due-recur-icon {
  display: inline-flex;
  align-items: center;
  margin-left: 3px;
  opacity: 0.85;
}

.py-due-date.py-overdue {
  color: var(--suite-fg-on-accent, #ffffff);
  fill: var(--suite-fg-on-accent, #ffffff);
  background: var(--suite-status-danger-accent);
  border-color: var(--suite-status-danger-accent);
  font-weight: 600;
}

.py-due-date.py-due-today {
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
  border-color: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 45%, transparent);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 10%, transparent);
  font-weight: 500;
}

.py-due-date.py-scheduled-date {
  border-color: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 32%, transparent);
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 10%, transparent);
}

.py-todo .py-todo-actions .py-btn {
  font-size: .75em;
  line-height: 1.3;
  margin-left: 0;
  white-space: nowrap;
}

@media (min-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-todo .py-todo-actions .py-btn.py-not-scheduled,
  .py-todo .py-btn.py-priority- {
    opacity: 0;
    transition: opacity ease-in .14s;
  }

  .py-todo:hover .py-todo-actions .py-btn,
  .py-todo:focus-within .py-todo-actions .py-btn,
  .py-todo:hover .py-btn.py-priority-,
  .py-todo:focus-within .py-btn.py-priority- {
    opacity: 1 !important;
  }
}

.py-projects .tc-droppable.tc-dragover {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 18%, transparent);
  display: block;
}

/* Make the trailing end-of-list drop zone easy to hit and give clear visual drop indicator */
.py-todos .tc-tagged-draggable-list > .tc-droppable,
.py-reorder-projects .tc-tagged-draggable-list > .tc-droppable,
.py-list-end-dropzone {
  display: block;
  min-height: 22px;
}

.py-todos .tc-tagged-draggable-list > .tc-droppable > div:last-child,
.py-reorder-projects .tc-tagged-draggable-list > .tc-droppable > div:last-child,
.py-list-end-dropzone-spacer {
  min-height: 22px;
}

.py-todos .tc-tagged-draggable-list .tc-droppable.tc-dragover > .tc-droppable-placeholder,
.py-reorder-projects .tc-tagged-draggable-list .tc-droppable.tc-dragover > .tc-droppable-placeholder {
  display: block;
  height: 32px;
  line-height: 32px;
  margin: 4px 0;
  border-radius: 6px;
  border: 2px dashed var(--tpc-primary, <<colour primary>>);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent);
}

.py-tabs.tc-tab-buttons {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
}

.py-tabs.tc-tab-buttons button {
  font-weight: bold;
  font-size: 1.2em;
  border: 0;
  padding: .6em .8em .4em .8em;
  background: transparent;
  cursor: pointer;
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
  flex-shrink: 0;
  white-space: nowrap;
}

@media (max-width: 640px), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-tabs.tc-tab-buttons button {
    font-size: .78em;
    padding: 6px 8px;
    flex: 1 0 auto;
    text-align: center;
  }

  .py-tabs.tc-tab-buttons button svg {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    margin: 0 auto 4px auto;
  }
}

.py-tabs.tc-tab-buttons button.tc-tab-selected {
  border: 0;
  border-bottom: 4px solid var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
}

.py-scheduled-drop-down h4 {
  margin: 5px 10px;
  color: var(--tpc-foreground, <<colour foreground>>);
  font-weight: bold;
}

.py-scheduled-drop-down .clear {
  margin: 5px 10px;
}

.tc-drop-down.py-drop-down {
  min-width: 196px;
  max-width: min(280px, calc(100vw - 20px));
  margin: 0;
  padding: 4px;
  background: var(--suite-surface-elevated, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent));
  border-radius: var(--suite-radius-md, 10px);
  box-shadow: var(--suite-shadow-lg, 0 8px 24px rgba(0, 0, 0, 0.18));
  box-sizing: border-box;
  overflow-x: hidden;
  white-space: normal;
}

@supports (position-area: block-end) {
  [popover].py-drop-down {
    position-area: block-end span-inline-start;
    inset: auto;
    position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
  }
