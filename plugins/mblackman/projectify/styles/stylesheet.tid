  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  color-scheme: light dark;
  accent-color: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
}

.py-due-time {
  font-weight: 500;
  opacity: 0.92;
}

.py-inline-label {
  font-size: 12px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin: 0;
}

.py-menu-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2px;
  padding: 1px 2px;
  width: 100%;
  box-sizing: border-box;
}

.tc-drop-down.py-drop-down .py-menu-actions-grid .tc-btn-invisible {
  font-size: 12px;
  line-height: 1.4em;
  padding: 4px 6px;
  border-radius: 5px;
  min-width: 0;
  white-space: nowrap;
}

.tc-drop-down.py-drop-down .py-menu-actions-grid .tc-btn-invisible:last-child:nth-child(odd),
.tc-drop-down.py-drop-down .py-menu-actions-grid .tc-btn-invisible.py-menu-action-full {
  grid-column: 1 / -1;
}

.tc-drop-down.py-drop-down .tc-btn-invisible.py-menu-action-danger {
  color: var(--suite-status-danger-fg);
  fill: var(--suite-status-danger-fg);
}

.tc-drop-down.py-drop-down .tc-btn-invisible.py-menu-action-danger:hover:not(:disabled, [aria-disabled="true"]) {
  color: var(--suite-status-danger-fg);
  fill: var(--suite-status-danger-fg);
  background: var(--suite-status-danger-bg);
}

.tc-drop-down.py-date-picker,
.tc-drop-down.py-todo-actions-drop-down {
  width: 248px;
  min-width: 0;
  max-width: calc(100vw - 20px);
  max-height: min(82vh, 520px);
  overflow-y: auto;
  overflow-x: hidden;
  overscroll-behavior: contain;
  box-sizing: border-box;
}

.py-recur-picker,
.py-context-picker,
.py-dependency-picker,
.py-drop-down-section {
  padding: 4px 8px;
}

.py-drop-down-section .py-label,
.py-dependency-picker .py-label {
  display: block;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  padding: 2px 4px 4px 4px;
}

.tc-drop-down.py-drop-down .tc-btn-invisible.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 14%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
  font-weight: 600;
  border-radius: 4px;
}

.py-inline-section-add input.py-input {
  width: 170px;
  padding: 4px 8px;
  font-size: 13px;
}

.py-recur-label {
  font-size: 12px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 4px;
}

.py-recur-options,
.py-context-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.tc-drop-down.py-drop-down .py-recur-options .py-recur-chip,
.tc-drop-down.py-drop-down .py-context-chips .py-context-chip {
  width: auto;
  font-size: 11px;
  line-height: 1.4;
  padding: 2px 7px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 35%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.tc-drop-down.py-drop-down .py-recur-options .py-recur-chip.py-active,
.tc-drop-down.py-drop-down .py-context-chips .py-context-chip.py-active {
  background: var(--tpc-primary, <<colour primary>>);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-background, <<colour background>>);
}

/* Badges & Context pills on todo items */
.py-badge,
.py-context-pill,
.tc-btn-invisible.py-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.75em;
  line-height: 1.3;
  padding: 2px 7px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 14%, transparent);
  color: color-mix(in srgb, var(--tpc-foreground, <<colour foreground>>) 75%, var(--tpc-muted-foreground, <<colour muted-foreground>>));
  fill: currentColor;
  white-space: nowrap;
  max-width: 100%;
  box-sizing: border-box;
  border: 1px solid transparent;
}

.tc-btn-invisible.py-subtask-pill {
  cursor: pointer;
  transition: background-color 0.14s ease, border-color 0.14s ease, color 0.14s ease;
}

.tc-btn-invisible.py-subtask-pill:hover,
.tc-btn-invisible.py-subtask-pill.py-expanded {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 14%, transparent);
  border-color: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 35%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
}

.py-badge-blocked,
a.py-badge-blocked {
  color: var(--suite-status-danger-fg);
  fill: var(--suite-status-danger-fg);
  background: var(--suite-status-danger-bg);
  border: 1px solid var(--suite-status-danger-border);
  text-decoration: none;
  max-width: min(155px, 100%);
  min-width: 0;
}

a.py-badge-blocked:hover {
  background: color-mix(in srgb, var(--suite-status-danger-accent) 22%, transparent);
  text-decoration: none;
}

.py-badge-blocked-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

@media (max-width: 640px), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-badge-blocked,
  a.py-badge-blocked {
