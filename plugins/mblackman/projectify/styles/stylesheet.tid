}

.py-blocker-inline {
  flex-direction: column;
  align-items: stretch;
  gap: 4px;
}

.py-time-section {
  padding: 4px 6px 6px 6px;
  box-sizing: border-box;
  max-width: 100%;
}

.py-time-picker-control {
  display: flex;
  flex-direction: column;
  gap: 5px;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.py-time-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.py-time-badge {
  font-size: 10.5px;
  font-weight: 700;
  line-height: 1.2;
  padding: 1px 6px;
