}

.tc-drop-down.py-drop-down .py-quick-dates .py-calendar-toggle.py-active,
.tc-drop-down.py-drop-down .py-quick-dates .py-time-toggle.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 15%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
}

.py-calendar-container,
.py-time-panel-drawer {
  border-top: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 20%, transparent);
  margin-top: 3px;
  padding-top: 3px;
}

/* Collapsible <details> disclosure drawers inside task menus */
.py-menu-disclosure {
  margin: 0;
  padding: 0;
}

.py-menu-disclosure-summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 8px;
  margin: 0 4px;
  border-radius: 5px;
  font-size: 12px;
  font-weight: 500;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  cursor: pointer;
  user-select: none;
}

.py-menu-disclosure-summary::-webkit-details-marker {
  display: none;
}

.py-menu-disclosure-summary::after {
  content: "▸";
  font-size: 11px;
  opacity: 0.75;
  transition: transform 0.14s ease;
}

.py-menu-disclosure[open] > .py-menu-disclosure-summary {
  color: var(--tpc-foreground, <<colour foreground>>);
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 10%, transparent);
}

.py-menu-disclosure[open] > .py-menu-disclosure-summary::after {
  transform: rotate(90deg);
}

.py-menu-disclosure-summary:hover {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 12%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-disclosure-summary-label {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.py-disclosure-summary-label svg {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

.py-disclosure-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--tpc-primary, <<colour primary>>);
  margin-left: 3px;
  flex-shrink: 0;
}

.py-menu-disclosure-body {
  padding: 3px 2px 2px 2px;
  box-sizing: border-box;
  max-width: 100%;
  overflow-x: hidden;
}

.py-recur-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
