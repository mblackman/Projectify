.py-banner-blocked .py-dependency-banner-label {
  color: var(--suite-status-danger-fg);
  fill: var(--suite-status-danger-fg);
}

.py-banner-blocking .py-dependency-banner-label {
  color: var(--suite-status-warning-fg);
  fill: var(--suite-status-warning-fg);
}

.py-dependency-banner-items {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1 1 auto;
}

.py-dependency-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 28%, transparent);
  font-weight: 500;
}

.py-dependency-clear {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  padding: 2px 4px;
  border-radius: 4px;
  cursor: pointer;
  opacity: 0.7;
}

.py-dependency-clear:hover {
  opacity: 1;
}

.py-context-pill {
  color: var(--tpc-primary, <<colour primary>>);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent);
}

/* Inline Sub-tasks & Inline Edit */
.py-todo-check-btn {
  display: inline-flex;
  align-items: center;
  padding: 0;
  margin: 0;
  cursor: pointer;
}

.py-subtask-toggle {
  display: inline-flex;
  align-items: center;
  margin-left: 4px;
  padding: 2px 4px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  border-radius: 4px;
  cursor: pointer;
  flex-shrink: 0;
}

.py-subtask-toggle svg,
.tc-tiddler-frame .py-subtask-toggle svg {
  width: 12px;
  height: 12px;
  max-width: none;
  flex-shrink: 0;
  display: block;
}

.py-subtask-toggle:hover {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 15%, transparent);
}

.py-subtasks-indent {
  margin-left: 24px;
  padding-left: 10px;
  border-left: 2px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
  margin-bottom: 6px;
}

.py-inline-subtask-form,
.py-inline-edit-row,
.py-inline-section-add {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 4px;
}

input.py-input.py-subtask-input,
input.py-input.py-inline-input {
  padding: 4px 8px;
  font-size: 0.9em;
  width: 240px;
}

/* Project Toolbar, View Switcher, and Sections */
.py-project-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0 8px 0;
}

.py-project-toolbar h2 {
  margin: 0;
}

.py-project-toolbar-controls {
  display: flex;
  align-items: center;
  gap: 6px;
}

.py-view-switcher {
  display: inline-flex;
  gap: 4px;
}

.py-btn.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-primary, <<colour primary>>);
  fill: var(--tpc-primary, <<colour primary>>);
  font-weight: 600;
}

.py-project-section {
  margin-top: 14px;
}

.py-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
  border-bottom: 2px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 28%, transparent);
  margin-bottom: 4px;
}

.py-section-title-drop {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 auto;
}

.py-section-title {
  font-weight: 700;
  font-size: 0.95em;
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
}

.py-section-delete {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  opacity: 0.5;
  cursor: pointer;
}

.py-section-delete:hover {
  opacity: 1;
}

.py-section-footer,
.py-board-column-footer {
  margin-top: 6px;
}

.py-section-add-trigger,
.py-board-add-trigger {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.82em;
  font-weight: 500;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  padding: 4px 8px;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.14s ease, color 0.14s ease;
}

.py-board-add-trigger {
  width: 100%;
  box-sizing: border-box;
  justify-content: flex-start;
}

.py-section-add-trigger:hover,
.py-board-add-trigger:hover {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 14%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-section-inline-add {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  padding: 4px 0;
}

.py-board-inline-add {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-top: 4px;
}

.py-board-inline-add input.py-input.py-board-add-input {
  width: 100%;
  font-size: 0.88em;
  padding: 6px 8px;
}

.py-board-inline-add-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Kanban Board View */
.py-board-container {
  container-type: inline-size;
}

.py-board-mobile-switcher {
  display: none;
}

.py-board {
  display: grid;
  grid-template-columns: repeat(4, minmax(150px, 1fr));
  gap: 10px;
  margin: 12px 0 18px 0;
  align-items: start;
}

.py-board-column {
  background: var(--suite-surface-subtle);
  border: 1px solid var(--suite-border-subtle);
  border-radius: var(--suite-radius-md, 10px);
  padding: 10px;
  min-height: 160px;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.py-board-column-inner {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
}

.py-board-column-inner.tc-droppable.tc-dragover {
  outline: 2px dashed var(--tpc-primary, <<colour primary>>);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 6%, transparent);
  border-radius: 8px;
}

.py-board-column-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  padding-bottom: 6px;
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent);
}

.py-board-column-title {
  font-weight: 700;
  font-size: 0.9em;
}

.py-board-card-slot {
  display: block;
}

.py-board-card-slot.tc-droppable.tc-dragover > .tc-droppable-placeholder {
  display: block;
  height: 36px;
  margin-bottom: 8px;
  border-radius: 8px;
  border: 2px dashed var(--tpc-primary, <<colour primary>>);
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent);
}

.py-board-card-draggable {
  cursor: grab;
}

.py-board-card-draggable:active {
  cursor: grabbing;
}

.py-board-card-draggable .tc-drop-down {
  cursor: default;
}

.py-board .tc-reveal.tc-popup {
  position: fixed !important;
  z-index: 2000 !important;
}

.py-board .tc-reveal.tc-popup > .tc-drop-down.py-drop-down {
  position: static !important;
  right: auto !important;
  left: auto !important;
  margin: 0 !important;
  max-width: calc(100vw - 20px);
  max-height: calc(100vh - 20px);
  overflow-y: auto;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.24);
}

.py-board-cards .py-todo-item-wrapper {
  background: var(--suite-surface-card);
  border: 1px solid var(--suite-border-subtle);
  border-radius: var(--suite-radius-md, 10px);
  padding: 10px 10px 10px 12px;
  margin-bottom: 8px;
  box-shadow: var(--suite-shadow-xs);
  min-width: 0;
  overflow-wrap: break-word;
  transition: box-shadow 0.14s ease, border-color 0.14s ease;
}

.py-board-cards .py-todo-item-wrapper:hover {
  border-color: var(--suite-border-strong);
  box-shadow: var(--suite-shadow-sm);
}

.py-board-cards .py-todo-item-wrapper.py-has-priority-3 {
  border-left: 3px solid var(--suite-status-danger-accent);
}

.py-board-cards .py-todo-item-wrapper.py-has-priority-2 {
  border-left: 3px solid var(--suite-status-warning-accent);
}

.py-board-cards .py-todo-item-wrapper.py-has-priority-1 {
  border-left: 3px solid var(--suite-status-info-accent);
}

.py-board-cards .py-subtasks-indent .py-todo-item-wrapper {
  background: transparent;
  border: 0;
  border-bottom: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 16%, transparent);
  border-radius: 0;
  padding: 3px 0;
  margin-bottom: 2px;
  box-shadow: none;
}

.py-board-cards .py-subtasks-indent .py-todo-item-wrapper:last-of-type {
  border-bottom: 0;
}

.py-board-cards .py-todo-item-wrapper > .py-todo {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  padding: 0;
}

.py-board-cards .py-todo-item-wrapper > .py-todo > .py-todo-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1 1 0%;
  min-width: 0;
}

.py-board-cards .py-todo-item-wrapper > .py-todo > .py-todo-body > .py-todo-title-row {
  width: 100%;
  min-width: 0;
  align-items: flex-start;
  font-weight: 500;
}

.py-board-cards .py-todo-item-wrapper > .py-todo > .py-todo-menu {
  flex-shrink: 0;
  margin-left: auto;
  margin-right: -4px;
  margin-top: -2px;
}

.py-board-cards .py-todo-item-wrapper > .py-todo > .py-todo-menu .py-todo-quick-edit {
  display: none;
}

.py-board-cards .py-todo-item-wrapper > .py-todo > .py-todo-body > .py-todo-actions {
  width: 100%;
  justify-content: flex-start;
  gap: 4px;
  margin-top: 2px;
  min-width: 0;
  max-width: 100%;
}

.py-board-cards .py-todo .py-todo-actions .py-badge,
.py-board-cards .py-todo .py-todo-actions .py-context-pill,
.py-board-cards .py-todo .py-todo-actions .py-btn {
  margin-left: 0;
  max-width: 100%;
  font-size: 0.72em;
  padding: 2px 6px;
}

.py-board-cards .py-todo .py-todo-actions .py-due-date {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.25;
}

.py-board-cards .py-subtasks-indent {
  margin-left: 6px;
  padding-left: 8px;
  margin-top: 6px;
}

.py-board-cards .py-inline-subtask-form,
.py-board-cards .py-inline-edit-row {
  flex-wrap: wrap;
  margin-top: 6px;
}

.py-board-cards input.py-input.py-subtask-input,
.py-board-cards input.py-input.py-inline-input {
  width: 100%;
  min-width: 0;
}

@container (max-width: 680px) {
  .py-board-mobile-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0 6px 0;
    margin-top: 6px;
  }

  .py-board-mobile-switcher::-webkit-scrollbar {
    display: none;
  }

  .py-board-mobile-switcher .py-board-tab {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 0.8em;
    padding: 5px 10px;
    min-height: var(--suite-touch-target, 44px);
  }

  .py-board-mobile-switcher .py-board-tab .py-count {
    font-size: 10.5px;
    padding: 1px 6px;
    min-width: 18px;
  }

  .py-board {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 12px;
    padding-bottom: 6px;
    margin-top: 6px;
  }

  .py-board::-webkit-scrollbar {
    display: none;
  }

  .py-board-column {
    flex: 0 0 85%;
    max-width: 85%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 180px;
  }

  .py-board::after {
    content: "";
    flex: 0 0 calc(15% - 12px);
    min-width: 1px;
  }

  .py-board-column.py-board-col-active {
    border-color: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 55%, transparent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent);
  }
}

@media (max-width: 640px), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-board-mobile-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0 6px 0;
    margin-top: 6px;
  }

  .py-board-mobile-switcher::-webkit-scrollbar {
    display: none;
  }

  .py-board-mobile-switcher .py-board-tab {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 0.8em;
    padding: 5px 10px;
    min-height: var(--suite-touch-target, 44px);
  }

  .py-board-mobile-switcher .py-board-tab .py-count {
    font-size: 10.5px;
    padding: 1px 6px;
    min-width: 18px;
  }

  .py-board {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 12px;
    padding-bottom: 6px;
    margin-top: 6px;
  }

  .py-board::-webkit-scrollbar {
    display: none;
  }

  .py-board-column {
    flex: 0 0 85%;
    max-width: 85%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 180px;
  }

  .py-board::after {
    content: "";
    flex: 0 0 calc(15% - 12px);
    min-width: 1px;
  }

  .py-board-column.py-board-col-active {
    border-color: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 55%, transparent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent);
  }
}

/* Eisenhower Matrix & Review Dashboards */
.py-matrix-dashboard,
.py-review-dashboard {
  container-type: inline-size;
}

.py-matrix-grid,
.py-review-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--suite-card-gap, 14px);
  margin: 12px 0;
}

@container (max-width: 640px) {
  .py-matrix-grid,
  .py-review-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-matrix-grid,
  .py-review-grid {
    grid-template-columns: 1fr;
  }
}

.py-matrix-quadrant,
.py-review-panel {
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 24%, transparent));
  border-radius: var(--suite-radius-md, 10px);
  padding: var(--suite-card-padding-md, 14px 16px);
  background: var(--suite-surface-card, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  box-shadow: var(--suite-shadow-xs);
}

.py-matrix-quadrant-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8px;
}

.py-matrix-quadrant-header h4,
.py-review-panel h3 {
  margin: 0;
}

.py-matrix-subtitle {
  font-size: 0.8em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-quadrant-do-first {
  border-top: 3px solid var(--suite-status-danger-accent);
}

.py-quadrant-schedule {
  border-top: 3px solid var(--tpc-primary, <<colour primary>>);
}

.py-quadrant-delegate {
  border-top: 3px solid var(--suite-status-warning-accent);
}

.py-quadrant-backlog {
  border-top: 3px solid var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-empty-quadrant {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  font-size: 0.9em;
  padding: 8px 0;
}

/* Context filter bar, Today heading, & Presets */
.py-context-filter-bar,
.py-preset-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 8px 0 12px 0;
}

.py-today-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.py-quick-capture-toolbar {
  justify-content: space-between;
  flex-wrap: wrap;
}

.py-select-compact {
  appearance: none;
  -webkit-appearance: none;
  font-size: 0.85em;
  padding: 4px 2rem 4px 10px;
  border-radius: var(--suite-radius-sm, 8px);
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 40%, transparent));
  background-color: var(--suite-surface-input, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  background-image: linear-gradient(45deg, transparent 50%, var(--suite-fg-muted, var(--tpc-muted-foreground, <<colour muted-foreground>>)) 50%),
                    linear-gradient(135deg, var(--suite-fg-muted, var(--tpc-muted-foreground, <<colour muted-foreground>>)) 50%, transparent 50%);
  background-position:
    calc(100% - 14px) calc(50% - 2px),
    calc(100% - 9px) calc(50% - 2px);
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
}

.py-select-compact:focus-visible {
  outline: 2px solid transparent;
  outline-offset: 2px;
  border-color: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
  box-shadow: var(--suite-focus-ring);
}

/* Modern Help & Reference Documentation Grid */
.py-doc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
  margin: 12px 0 20px 0;
}

.py-doc-card {
  background: var(--suite-surface-card, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 7%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 22%, transparent));
  border-radius: var(--suite-radius-md, 10px);
  padding: var(--suite-card-padding-md, 12px 14px);
  box-shadow: var(--suite-shadow-xs);
}

.py-doc-card h4 {
  margin: 0 0 6px 0;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.95em;
  color: var(--tpc-tiddler-title-foreground, <<colour tiddler-title-foreground>>);
  fill: var(--tpc-primary, <<colour primary>>);
}

.py-doc-card p {
  margin: 0;
  font-size: 0.85em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  line-height: 1.4;
}

/* Smart Quick-Add Autocomplete Menu & Live Token Preview */
.py-quick-input-wrapper {
  position: relative;
  width: 100%;
}

.py-inline-subtask-form .py-quick-input-wrapper {
  width: auto;
}

.py-smart-token-preview {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  margin-top: 4px;
}

.py-smart-token-preview[hidden] {
  display: none !important;
}

.py-token-pill {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 1px 7px;
  border-radius: var(--suite-radius-pill, 9999px);
  font-size: var(--suite-text-xs, 0.75rem);
  font-weight: 600;
  line-height: 1.35;
  background: var(--suite-accent-bg, color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 12%, transparent));
  color: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
  border: 1px solid var(--suite-accent-border, color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 30%, transparent));
  font-variant-numeric: tabular-nums;
}

.py-token-pill.py-priority-3 {
  background: var(--suite-status-danger-bg);
  color: var(--suite-status-danger-fg);
  border-color: var(--suite-status-danger-border);
}

.py-token-pill.py-priority-2 {
  background: var(--suite-status-warning-bg);
  color: var(--suite-status-warning-fg);
  border-color: var(--suite-status-warning-border);
}

.py-token-pill.py-priority-1 {
  background: var(--suite-status-info-bg);
  color: var(--suite-status-info-fg);
  border-color: var(--suite-status-info-border);
}

.py-autocomplete-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  z-index: 1200;
  min-width: 240px;
  max-width: min(360px, calc(100vw - 32px));
  max-height: 220px;
  overflow-y: auto;
  overscroll-behavior: contain;
  background: var(--suite-surface-elevated, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 30%, transparent));
  border-radius: var(--suite-radius-md, 10px);
  box-shadow: var(--suite-shadow-lg, 0 6px 20px rgba(0, 0, 0, 0.22));
  padding: 4px;
}

.py-autocomplete-menu[hidden] {
  display: none !important;
}

.py-autocomplete-menu .tc-btn-invisible.py-autocomplete-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  box-sizing: border-box;
  padding: 5px 8px;
  border-radius: 5px;
  font-size: 13px;
  line-height: 1.4;
  text-align: left;
  color: var(--tpc-foreground, <<colour foreground>>);
  cursor: pointer;
}

.py-autocomplete-menu .tc-btn-invisible.py-autocomplete-item:hover,
.py-autocomplete-menu .tc-btn-invisible.py-autocomplete-item.py-active {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 15%, transparent);
  color: var(--tpc-primary, <<colour primary>>);
}

.py-autocomplete-label {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.py-autocomplete-prefix {
  color: var(--tpc-primary, <<colour primary>>);
  font-weight: 700;
  margin-right: 1px;
}

.py-autocomplete-badge {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 14%, transparent);
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  white-space: nowrap;
  flex-shrink: 0;
}

/* Push Reminders & Focus Timers */
.py-reminder-section {
  padding: 4px 10px 6px 10px;
}

.py-reminder-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-bottom: 4px;
}

.tc-drop-down.py-drop-down .py-reminder-header .py-reminder-cancel {
  width: auto;
  font-size: 11px;
  line-height: 1.3;
  padding: 1px 6px;
  border-radius: 4px;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
}

.tc-drop-down.py-drop-down .py-reminder-header .py-reminder-cancel:hover {
  color: var(--suite-status-danger-fg);
  background: var(--suite-status-danger-bg);
}

.py-reminder-chips {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4px;
}

.tc-drop-down.py-drop-down .py-reminder-chips .py-reminder-chip {
  justify-content: center;
  text-align: center;
  font-size: 11.5px;
  font-weight: 600;
  line-height: 1.4;
  min-height: 28px;
  padding: 4px 6px;
  border-radius: 6px;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 32%, transparent);
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 8%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.tc-drop-down.py-drop-down .py-reminder-chips .py-reminder-chip:hover {
  background: color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-primary, <<colour primary>>);
}

.py-review-toolbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 6px;
  margin: 4px 0 10px 0;
}

.py-push-status-active {
  border-color: var(--suite-status-success-border);
}

/* Touch drag-and-drop ghost pill and mobile popup ergonomics */
.py-touch-drag-ghost {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  background: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-background, <<colour background>>);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
  max-width: 240px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.py-drag-handle.tc-dragging {
  opacity: 0.5;
  color: var(--tpc-primary, <<colour primary>>);
}

@media (max-width: 640px), (pointer: coarse), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .tc-drop-down.py-drop-down {
    max-width: calc(100vw - 20px);
    box-sizing: border-box;
  }

  .tc-drop-down.py-date-picker,
  .tc-drop-down.py-todo-actions-drop-down {
    width: min(296px, calc(100vw - 20px));
  }

  .tc-drop-down .py-status-selector .tc-btn-invisible,
  .tc-drop-down .py-priorities .tc-btn-invisible {
    min-height: var(--suite-control-height-sm, 36px);
    padding: 6px 4px;
  }

  .tc-drop-down.py-drop-down .py-quick-dates .tc-btn-invisible,
  .tc-drop-down.py-drop-down .py-menu-actions-grid .tc-btn-invisible,
  .py-menu-disclosure-summary {
    min-height: var(--suite-control-height-sm, 36px);
    padding: 6px 8px;
  }

  .tc-drop-down.py-drop-down .py-time-presets .py-time-chip,
  .tc-drop-down.py-drop-down .py-recur-chips .py-time-chip,
  .tc-drop-down.py-drop-down .py-time-custom-row .py-time-step-btn,
  .tc-drop-down.py-drop-down .py-reminder-chips .py-reminder-chip {
    min-height: var(--suite-control-height-sm, 36px);
  }

  .tc-drop-down.py-drop-down input.py-input.py-time-input {
    font-size: 1rem;
    min-height: var(--suite-control-height-sm, 36px);
  }

  input.py-input.py-subtask-input,
  input.py-input.py-inline-input {
    flex: 1 1 auto;
    min-width: 120px;
    width: auto;
  }

  .py-inline-subtask-form,
  .py-inline-edit-row {
    flex-wrap: wrap;
    width: 100%;
  }

  .py-inline-subtask-form .py-quick-input-wrapper {
    flex: 1 1 180px;
  }

  .py-subtasks-indent {
    margin-left: 14px;
    padding-left: 8px;
  }
}
