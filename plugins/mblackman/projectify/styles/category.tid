\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.py-category-pill {
  position: relative;
  width: 1em;
  height: 1em;
  display: inline-block;
  vertical-align: middle;
  border-radius: 50%;
  margin-right: 4px;
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
}

.py-category-pill::after {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 1px solid var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-category-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: -4px;
  margin-bottom: 10px;
}
