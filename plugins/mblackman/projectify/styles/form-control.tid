.py-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: var(--suite-control-height-md, 36px);
  border-radius: var(--suite-radius-sm, 8px);
  border: 1px solid var(--suite-border-subtle, color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 40%, transparent));
  background: var(--suite-surface-card, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  fill: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  padding: 6px 14px;
  font-size: 0.88em;
  font-weight: 600;
  cursor: pointer;
  box-sizing: border-box;
  transition: background-color 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.py-btn:hover {
  background: var(--suite-surface-hover, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  border-color: var(--suite-border-strong, var(--tpc-primary, <<colour primary>>));
}

.py-btn:focus {
  outline: 0 none;
}

.py-btn:focus-visible {
  box-shadow: var(--suite-focus-ring, 0 0 0 0.2rem color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 30%, transparent));
}

.py-btn:active {
  box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, .08);
}

.py-btn.btn-small {
  min-height: var(--suite-control-height-sm, 30px);
  font-size: .82em;
  padding: 4px 10px;
}

.py-btn.btn-primary,
.tc-tiddler-frame .py-btn.btn-primary {
  background-color: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
  border-color: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
  color: var(--suite-fg-on-accent, #ffffff);
  fill: var(--suite-fg-on-accent, #ffffff);
  font-weight: 600;
}

.py-btn.btn-primary:hover,
.tc-tiddler-frame .py-btn.btn-primary:hover {
  background-color: var(--suite-accent-hover, var(--tpc-primary, <<colour primary>>));
  border-color: var(--suite-accent-hover, var(--tpc-primary, <<colour primary>>));
}

.py-btn.btn-primary:active {
  box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 35%, transparent);
}

.py-btn.btn-danger {
  border-color: var(--suite-status-danger-border, #e73939);
  color: var(--suite-status-danger-fg, #e73939);
  fill: var(--suite-status-danger-fg, #e73939);
}

.py-btn.btn-danger:hover {
  background: var(--suite-status-danger-bg);
}

.py-btn.btn-danger:active {
  box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--suite-status-danger-accent, #e73939) 25%, transparent);
}

.py-form .py-control-group {
  margin: 8px 0;
}

.py-form .py-control-group .py-label {
  padding: 0;
}

.py-actions {
  margin: 10px 0 20px 0;
}

.py-form .py-actions {
  margin-top: 20px;
}

.py-composite-input {
  position: relative;
  padding: 10px 12px;
  border-radius: var(--suite-radius-md, 10px);
  background: var(--suite-surface-subtle, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  border: 1px solid var(--suite-border-subtle, var(--tpc-tiddler-editor-border, <<colour tiddler-editor-border>>));
}

.py-composite-input.py-omnibar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 8px 6px 12px;
  border-radius: var(--suite-radius-md, 10px);
  margin: 8px 0 12px 0;
  box-shadow: var(--suite-shadow-xs, 0 1px 2px rgba(0, 0, 0, 0.04));
  transition: border-color 0.14s ease, box-shadow 0.14s ease;
}

.py-composite-input.py-omnibar:focus-within {
  border-color: var(--tpc-primary, <<colour primary>>);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 16%, transparent);
}

.py-composite-input.py-omnibar .py-quick-input-wrapper {
  flex: 1 1 180px;
  min-width: 0;
}

.py-composite-input.py-omnibar input.py-input.py-omnibar-input {
  padding: 4px 0;
  font-size: 0.95em;
}

.py-composite-input.py-omnibar .py-omnibar-controls {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-top: 0;
  flex-shrink: 0;
}

.py-composite-input.py-omnibar .py-omnibar-controls .py-schedule-caption {
  display: none;
}

@media (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-composite-input.py-omnibar {
    flex-wrap: wrap;
    border-radius: 12px;
    padding: 8px 10px;
  }

  .py-composite-input.py-omnibar .py-quick-input-wrapper {
    flex: 1 1 100%;
  }

  .py-composite-input.py-omnibar .py-omnibar-controls {
    width: 100%;
    justify-content: flex-end;
    padding-top: 4px;
    border-top: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 15%, transparent);
  }
}

.py-composite-input:focus-within {
  border-color: var(--tpc-primary, <<colour primary>>);
}

.py-composite-input input.py-input,
.tc-tiddler-frame .py-composite-input input.py-input {
  border: none;
  width: 100%;
  min-height: 26px;
  padding: 5px 0;
  background: transparent;
  box-shadow: none;
  font-family: inherit;
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-composite-input input.py-input:focus,
.tc-tiddler-frame .py-composite-input input.py-input:focus {
  border: none;
  box-shadow: none;
}

.py-composite-input .py-todo-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  font-size: .9em;
}

.tc-tiddler-frame input.py-input,
.tc-tiddler-frame select.py-input,
input.py-input,
select.py-input,
.py-form select {
  transition: border .14s ease-in-out, box-shadow .14s ease-in-out, background-color .14s ease-in-out;
  border: 1px solid var(--suite-border-subtle, var(--tpc-tiddler-editor-border, <<colour tiddler-editor-border>>));
  background-color: var(--suite-surface-input, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  color: var(--suite-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  min-height: var(--suite-control-height-md, 36px);
  padding: 6px 10px;
  border-radius: var(--suite-radius-sm, 8px);
  font-family: inherit;
  box-shadow: none;
  width: 300px;
  max-width: 100%;
  box-sizing: border-box;
}

.tc-tiddler-frame input.py-input:focus,
.tc-tiddler-frame select.py-input:focus,
input.py-input:focus,
select.py-input:focus,
.py-form select:focus {
  box-shadow: var(--suite-focus-ring, 0 0 0.2rem 0 var(--tpc-primary, <<colour primary>>));
  outline: 0;
  border-color: var(--suite-accent, var(--tpc-primary, <<colour primary>>));
}

input.py-input.input-larger {
  width: 450px;
  max-width: 100%;
}

input.py-input.input-large {
  width: 100%;
  padding: .5em 1em;
  font-size: 1.1em;
}

.py-todo input[type="checkbox"],
.py-toggle-todo-button input[type="checkbox"] {
  display: none;
}

.py-checkbox {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  cursor: pointer;
  transition: color ease-in .2s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  line-height: 1;
}

.py-checkbox > span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
}

.py-checkbox svg,
.tc-tiddler-frame .py-checkbox svg {
  width: 18px;
  height: 18px;
  max-width: none;
  flex-shrink: 0;
  display: block;
}

.py-checkbox .todo-hover {
  display: none;
}

@media (hover: hover) {
  .py-checkbox:hover .todo-hover {
    display: inline-flex;
  }

  .py-checkbox:hover .todo {
    display: none;
  }

  .py-checkbox:hover {
    color: var(--suite-status-success-accent, #2da562);
  }
}

.py-checkbox .done {
  color: var(--suite-status-success-accent, #2da562);
  display: inline-flex;
}

.py-popup {
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  color: var(--tpc-foreground, <<colour foreground>>);
  border-radius: 8px;
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.3);
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 25%, transparent);
  padding: 5px 20px;
  width: 350px;
  max-width: 90vw;
  box-sizing: border-box;
}
