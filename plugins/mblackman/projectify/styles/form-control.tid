.py-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 1.5em;
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 40%, transparent);
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  color: var(--tpc-foreground, <<colour foreground>>);
  fill: var(--tpc-foreground, <<colour foreground>>);
  padding: .3em 1em;
  cursor: pointer;
  transition: box-shadow ease-in .1s, border-color ease-in .1s;
}

.py-btn:focus {
  outline: 0 none;
}

.py-btn:focus-visible {
  box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 30%, transparent);
}

.py-btn:active {
  box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, .08);
}

.py-btn.btn-small {
  font-size: .9em;
  padding: .2em .8em;
}

.py-btn.btn-primary {
  background-color: var(--tpc-primary, <<colour primary>>);
  border-color: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-background, <<colour background>>);
  fill: var(--tpc-background, <<colour background>>);
}

.py-btn.btn-primary:active {
  box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--tpc-primary, <<colour primary>>) 35%, transparent);
}

.py-btn.btn-danger {
  border-color: #e73939;
  color: #e73939;
  fill: #e73939;
}

.py-btn.btn-danger:active {
  box-shadow: 0 0 0 0.2rem rgba(231, 57, 57, .2);
}

.py-form .py-control-group {
  margin: 8px 0;
}

.py-form .py-control-group .py-label {
  padding: 0;
}

.py-actions {
  margin: 10px 0 20px 0;
}

.py-form .py-actions {
  margin-top: 20px;
}

.py-composite-input {
  position: relative;
  padding: 10px 12px;
  border-radius: 8px;
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  border: 1px solid var(--tpc-tiddler-editor-border, <<colour tiddler-editor-border>>);
}

.py-composite-input:focus-within {
  border-color: var(--tpc-primary, <<colour primary>>);
}

.py-composite-input input.py-input {
  border: none;
  width: 100%;
  padding: 5px 0;
  background: transparent;
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-composite-input input.py-input:focus {
  border: none;
  box-shadow: none;
}

.py-composite-input .py-todo-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  font-size: .9em;
}

input.py-input {
  transition: border .14s ease-in-out;
  border: 1px solid var(--tpc-tiddler-editor-border, <<colour tiddler-editor-border>>);
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  color: var(--tpc-foreground, <<colour foreground>>);
  padding: 8px;
  border-radius: 4px;
  width: 300px;
  max-width: 100%;
  box-sizing: border-box;
}

input.py-input:focus {
  box-shadow: 0 0 0.2rem 0 var(--tpc-primary, <<colour primary>>);
  outline: 0;
  border-color: var(--tpc-primary, <<colour primary>>);
}

input.py-input.input-larger {
  width: 450px;
  max-width: 100%;
}

input.py-input.input-large {
  width: 100%;
  padding: .5em 1em;
  font-size: 1.1em;
}

.py-todo input[type="checkbox"],
.py-toggle-todo-button input[type="checkbox"] {
  display: none;
}

.py-checkbox {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  cursor: pointer;
  transition: color ease-in .2s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  line-height: 1;
}

.py-checkbox > span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
}

.py-checkbox svg,
.tc-tiddler-frame .py-checkbox svg {
  width: 18px;
  height: 18px;
  max-width: none;
  flex-shrink: 0;
  display: block;
}

.py-checkbox .todo-hover {
  display: none;
}

@media (hover: hover) {
  .py-checkbox:hover .todo-hover {
    display: inline-flex;
  }

  .py-checkbox:hover .todo {
    display: none;
  }

  .py-checkbox:hover {
    color: #2da562;
  }
}

.py-checkbox .done {
  color: #2da562;
  display: inline-flex;
}

.py-popup {
  background: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  color: var(--tpc-foreground, <<colour foreground>>);
  border-radius: 8px;
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.3);
  border: 1px solid color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 25%, transparent);
  padding: 5px 20px;
  width: 350px;
  max-width: 90vw;
  box-sizing: border-box;
}
