.py-welcome {
  max-width: 800px;
  text-align: center;
  padding: 40px 20px;
  margin: 0 auto;
  background: var(--suite-surface-subtle, var(--tpc-message-background, <<colour message-background>>));
  color: var(--suite-fg-primary, var(--tpc-message-foreground, <<colour message-foreground>>));
  border: 1px dashed var(--suite-border-strong, transparent);
  border-radius: var(--suite-radius-lg, 14px);
}

.py-welcome .icon {
  font-size: 4em;
}

.py-welcome h3 {
  font-weight: bold;
}

.py-welcome p {
  margin: 0;
}
