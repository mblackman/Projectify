\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.py-link-muted {
  text-decoration: underline;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-link-muted:hover,
.py-link-muted:active {
  color: var(--tpc-primary, <<colour primary>>);
}

.py-icon {
  vertical-align: middle;
}

.py-pie circle {
  stroke: var(--tpc-primary, <<colour primary>>);
}

.py-pie circle:first-child {
  fill: var(--tpc-background, <<colour background>>);
}

.py-pie circle:last-child {
  fill: transparent;
}

.py-due-date svg {
  width: 1em;
  height: 1em;
}

.py-label {
  display: block;
  font-size: .8em;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  font-weight: 500;
  padding: 4px 0;
}

.py-right-aligned {
  text-align: right;
}

.py-drag-handle {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: grab;
  flex-shrink: 0;
  border-radius: 6px;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  transition: background-color 0.14s ease, color 0.14s ease;
}

.py-drag-handle:hover,
.py-drag-handle:active {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 14%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
}

.py-drag-handle:active {
  cursor: grabbing;
}

.py-drag-handle svg,
.tc-tiddler-frame .py-drag-handle svg {
  width: 17px;
  height: 17px;
  max-width: none;
  flex-shrink: 0;
  vertical-align: middle;
}

@media (max-width: 640px), (pointer: coarse), (max-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .py-drag-handle {
    width: 38px;
    height: 38px;
    margin-left: -6px;
    margin-top: -5px !important;
    margin-bottom: -5px;
  }

  .py-drag-handle svg,
  .tc-tiddler-frame .py-drag-handle svg {
    width: 19px;
    height: 19px;
  }
}

.py-banner {
  padding: 10px 20px;
  background: var(--tpc-notification-background, <<colour notification-background>>);
  border: 1px solid var(--tpc-notification-border, <<colour notification-border>>);
  margin: 10px 0;
  border-radius: 6px;
}

.py-banner button {
  text-decoration: underline;
}

.py-tip {
  margin: 10px 0;
  background: var(--tpc-notification-background, <<colour notification-background>>);
  color: var(--tpc-notification-foreground, <<colour notification-foreground>>);
  padding: 10px 14px;
  border-radius: 6px;
}

.py-tip-icon {
  font-size: 1.2em;
  margin-right: 4px;
}

.py-count {
  background: color-mix(in srgb, var(--tpc-muted-foreground, <<colour muted-foreground>>) 15%, transparent);
  color: var(--tpc-foreground, <<colour foreground>>);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  padding: 3px 8px;
  font-size: 11.5px;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  min-width: 22px;
  line-height: 1.2;
  vertical-align: middle;
  box-sizing: border-box;
}

.py-count.py-count-alert {
  background: var(--suite-status-danger-accent, #df3f3f);
  color: var(--suite-fg-on-accent, #ffffff);
}

.py-count.info {
  background: var(--tpc-primary, <<colour primary>>);
  color: var(--tpc-background, <<colour background>>);
}

.tc-tab-buttons .py-count {
  font-size: 10px;
  padding: 4px;
  min-width: 18px;
  margin-top: -0.5rem;
}

.py-pill-container {
  position: relative;
}

.py-pill-container .py-pill {
  position: absolute;
  top: 0;
  right: 2px;
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: var(--suite-status-danger-accent, #df3f3f);
}
