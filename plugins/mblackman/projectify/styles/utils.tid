\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.py-link-muted {
  text-decoration: underline;
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
}

.py-link-muted:hover,
.py-link-muted:active {
  color: var(--tpc-primary, <<colour primary>>);
}

.py-icon {
  vertical-align: middle;
}

.py-pie circle {
  stroke: var(--tpc-primary, <<colour primary>>);
}

.py-pie circle:first-child {
  fill: var(--tpc-background, <<colour background>>);
}

.py-pie circle:last-child {
  fill: transparent;
}

.py-due-date svg {
  width: 1em;
  height: 1em;
}

.py-label {
  display: block;
  font-size: .8em;
  opacity: .65;
  padding: 4px 0;
}

.py-right-aligned {
  text-align: right;
}

.py-drag-handle {
  color: var(--tpc-muted-foreground, <<colour muted-foreground>>);
  fill: currentColor;
  width: 18px;
  display: inline-flex;
  align-items: center;
  cursor: grab;
  flex-shrink: 0;
}

.py-drag-handle svg {
  vertical-align: middle;
}

.py-banner {
  padding: 10px 20px;
  background: var(--tpc-notification-background, <<colour notification-background>>);
  border: 1px solid var(--tpc-notification-border, <<colour notification-border>>);
  margin: 10px 0;
  border-radius: 6px;
}

.py-banner button {
  text-decoration: underline;
}

.py-tip {
  margin: 10px 0;
  background: var(--tpc-notification-background, <<colour notification-background>>);
  color: var(--tpc-notification-foreground, <<colour notification-foreground>>);
  padding: 10px 14px;
  border-radius: 6px;
}

.py-tip-icon {
  font-size: 1.2em;
  margin-right: 4px;
}

.py-count {
  background: #df3f3f;
  color: #ffffff;
  font-weight: bold;
  padding: 6px;
  font-size: 12px;
  text-align: center;
  display: inline-block;
  border-radius: 24px;
  min-width: 24px;
  line-height: 1;
  vertical-align: middle;
}

.py-count.info {
  background: var(--tpc-primary, <<colour primary>>);
}

.tc-tab-buttons .py-count {
  font-size: 10px;
  padding: 4px;
  min-width: 18px;
  margin-top: -0.5rem;
}

.py-pill-container {
  position: relative;
}

.py-pill-container .py-pill {
  position: absolute;
  top: 0;
  right: 2px;
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: #df3f3f;
}
