\procedure lingo-base() $:/language/projectify/

\procedure quick-capture-actions()
<$let title={{{ [{$:/temp/projectify/QuickCapture!!todo_name}trim[]] }}}>
  <%if [<title>!is[blank]] %>
    <$action-py-quick-add
      $state="$:/temp/projectify/QuickCapture"
      $field="todo_name"
      $tags="Inbox todo"
    />
    <$action-sendmessage $message="tm-close-tiddler"/>
  <%endif%>
</$let>
\end

!! {{$:/plugins/mblackman/projectify/images/quick-capture}} <<lingo QuickAddTodo>>

<div class="py-composite-input py-quick-capture-box">
  <$py-quick-input
    class="py-input input-large"
    tiddler="$:/temp/projectify/QuickCapture"
    field="todo_name"
    placeholder={{$:/language/projectify/AddToInbox/Placeholder}}
    focus="true"
    actions=<<quick-capture-actions>>
  />

  <div class="py-todo-actions py-quick-capture-toolbar">
    <$select tiddler="$:/temp/projectify/QuickCapture" field="project" default="Inbox" class="py-select-compact">
      <option value="Inbox">{{$:/language/projectify/Inbox}}</option>
      <$list filter=<<py-active-projects>> variable="proj">
        <option value=<<proj>>><$text text=<<proj>>/></option>
      </$list>
    </$select>

    <$let currentTiddler="$:/temp/projectify/QuickCapture">
      <$transclude $tiddler="$:/plugins/mblackman/projectify/ui/buttons/TodoDueDate" $mode="inline"/>
      <$transclude $tiddler="$:/plugins/mblackman/projectify/ui/buttons/TodoPriority" $mode="inline"/>
    </$let>

    <$button class="py-btn btn-small btn-primary" actions=<<quick-capture-actions>>>
      <<lingo AddTodo/Caption>>
    </$button>
  </div>
</div>
<label class="py-label py-right-aligned"><<lingo QuickCapture/Hint>></label>
