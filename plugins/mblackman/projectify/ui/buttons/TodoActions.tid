title: $:/plugins/mblackman/projectify/ui/buttons/TodoActions
type: text/vnd.tiddlywiki

\procedure lingo-base() $:/language/projectify/

\procedure move-todo-step-actions(direction)
<$let
  parentTag={{{ [<projectTag>!is[blank]] :else[all[current]tags[]tag[Project]limit[1]] :else[all[current]tags[]tag[SubProject]limit[1]] :else[all[current]tags[]match[Inbox]] }}}
>
  <%if [<parentTag>!is[blank]] %>
    <$set name="order" filter="[<parentTag>tagging[]]">
      <$list filter="[<parentTag>tagging[]]">
        <$action-deletefield $field="list-before"/>
        <$action-deletefield $field="list-after"/>
      </$list>
      <%if [<direction>match[up]] %>
        <$let
          prevItem={{{ [enlist:raw<order>tag[todo]!has[draft.of]!tag[done]before<currentTiddler>] }}}
        >
          <%if [<prevItem>!is[blank]] %>
            <$action-listops $tiddler=<<parentTag>> $field="list" $filter="+[enlist:raw<order>] +[insertbefore<currentTiddler>,<prevItem>]"/>
            <$action-sendmessage $message="tm-auto-save-wiki"/>
          <%endif%>
        </$let>
      <%else%>
        <$let
          nextItem={{{ [enlist:raw<order>tag[todo]!has[draft.of]!tag[done]after<currentTiddler>] }}}
        >
          <%if [<nextItem>!is[blank]] %>
            <$action-listops $tiddler=<<parentTag>> $field="list" $filter="+[enlist:raw<order>] +[insertbefore<nextItem>,<currentTiddler>]"/>
            <$action-sendmessage $message="tm-auto-save-wiki"/>
          <%endif%>
        </$let>
      <%endif%>
    </$set>
  <%endif%>
</$let>
\end

<$let
  popupTiddler=<<qualify "$:/state/projectify/todo-actions-dropdown">>
  cssClass="py-btn"
>
  <$button
    class=<<cssClass>>
    popup=<<popupTiddler>>
    tooltip={{$:/language/projectify/TodoActions/Hint}}
    aria-label={{$:/language/projectify/TodoActions/Hint}}
  >
    {{$:/plugins/mblackman/projectify/images/dots}}
  </$button>

  <$reveal state=<<popupTiddler>> type="popup" position="belowleft" animate="no">
    <div class="tc-drop-down py-drop-down py-date-picker py-todo-actions-drop-down">
      <%if [{$:/config/projectify/EnableMultiStatus}!match[no]] %>
        {{||$:/plugins/mblackman/projectify/ui/forms/TodoStatus}}
        <hr/>
      <%endif%>
      {{||$:/plugins/mblackman/projectify/ui/forms/TodoPriority}}
      <hr/>
      <$let compactCalendar="yes">
        {{||$:/plugins/mblackman/projectify/ui/forms/TodoDueDate}}
      </$let>
      <%if [{$:/config/projectify/EnableContexts}!match[no]] %>
        <hr/>
        {{||$:/plugins/mblackman/projectify/ui/forms/TodoContext}}
      <%endif%>
      <hr/>
      <div class="py-recur-inline py-blocker-inline tc-popup-handle">
        <label class="py-inline-label tc-popup-handle">
          {{$:/plugins/mblackman/projectify/images/lock}} <<lingo BlockedBy/Caption>>
        </label>
        <$let
          parentProj={{{ [all[current]tags[]tag[Project]limit[1]] [all[current]tags[]tag[SubProject]limit[1]] }}}
          candidateFilter="[all[tiddlers]tag<parentProj>tag[todo]!has[draft.of]!tag[done]!title<currentTiddler>sort[title]] [all[tiddlers]tag[todo]!has[draft.of]!tag[done]!title<currentTiddler>sort[title]] +[unique[]]"
        >
          <$select field="blocked-by" default="" class="py-select-compact py-select-blocker tc-popup-handle">
            <option value="">—</option>
            <$list filter=<<candidateFilter>> variable="blocker">
              <option value={{{ [<blocker>format:titlelist[]] }}}><$text text={{{ [<blocker>get[caption]!is[blank]else<blocker>] }}}/></option>
            </$list>
          </$select>
        </$let>
      </div>
      <hr/>
      <div class="py-menu-actions-grid">
        <$button class="tc-btn-invisible tc-popup-handle" actions="<$transclude $variable='move-todo-step-actions' direction='up'/>">
          {{$:/core/images/up-arrow}} <<lingo MoveUp/Caption>>
        </$button>
        <$button class="tc-btn-invisible tc-popup-handle" actions="<$transclude $variable='move-todo-step-actions' direction='down'/>">
          {{$:/core/images/down-arrow}} <<lingo MoveDown/Caption>>
        </$button>
        <$button class="tc-btn-invisible">
          {{$:/plugins/mblackman/projectify/images/checklist}} <<lingo AddSubTasks/Caption>>
          <$action-listops $tags="[[SubProject]]"/>
          <$action-setfield $tiddler=<<subtaskState>> text="yes"/>
          <$action-sendmessage $message="tm-auto-save-wiki"/>
        </$button>
        <$button class="tc-btn-invisible">
          {{$:/core/images/edit-button}} <<lingo RenameTodo/Caption>>
          <$action-setfield $tiddler=<<editState>> text={{{ [{!!caption}!is[blank]else{!!title}] }}}/>
        </$button>
        {{||$:/plugins/mblackman/projectify/ui/forms/TodoConvert}}
      </div>
    </div>
  </$reveal>
</$let>
