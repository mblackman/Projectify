title: $:/plugins/mblackman/projectify/ui/buttons/SelectCategory
type: text/vnd.tiddlywiki

\procedure lingo-base() $:/language/projectify/

<$let popupTiddler=<<qualify "$:/state/projectify/category-dropdown">>>
  <$button
    popup=<<popupTiddler>>
    class="py-btn btn-small"
    tooltip={{$:/language/projectify/SetCategory/Hint}}
  >
    <%if [<currentTiddler>has[category]] %>
      <$tiddler tiddler={{!!category}}>
        {{||$:/plugins/mblackman/projectify/ui/category/Category}}
      </$tiddler>
    <%else%>
      <<lingo SetCategory/Caption>>
    <%endif%>
  </$button>

  <$reveal state=<<popupTiddler>> type="popup" position="below" animate="yes" class="tc-drop-down py-drop-down">
    <$list filter=<<py-all-categories>> variable="category">
      <$button class="tc-btn-invisible">
        <$tiddler tiddler=<<category>>>
          {{||$:/plugins/mblackman/projectify/ui/category/Category}}
        </$tiddler>
        <$action-setfield category=<<category>>/>
        <$action-sendmessage $message="tm-auto-save-wiki"/>
      </$button>
    </$list>
    <$button class="tc-btn-invisible">
      {{$:/plugins/mblackman/projectify/images/slash-circle}} <<lingo Clear>>
      <$action-deletefield $field="category"/>
      <$action-sendmessage $message="tm-auto-save-wiki"/>
    </$button>
    <hr/>
    <$link to="$:/plugins/mblackman/projectify/ui/config/Categories">
      <<lingo EditCategories>>
    </$link>
  </$reveal>
</$let>
