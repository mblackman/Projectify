\procedure lingo-base() $:/language/projectify/

<$let category={{!!category}}>
  <li class="py-project">
    <div class="py-project-heading">
      <div class="py-project-title">
        {{||$:/plugins/mblackman/projectify/images/pie}} <$link to={{!!title}}><$view field="title"/></$link>
      </div>
      <%if [<category>!is[blank]] %>
        <div class="py-project-category">
          <$tiddler tiddler=<<category>>>
            {{||$:/plugins/mblackman/projectify/ui/category/Category}}
          </$tiddler>
        </div>
      <%endif%>
    </div>
    <div class="py-project-infos">
      <$count filter=<<py-open-todos>>/> <<lingo OpenTasks>>
    </div>
  </li>
</$let>
