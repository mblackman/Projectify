<$let
  stateTiddler="$:/state/projectify/todo-filter"
  popupTiddler=<<qualify "$:/state/projectify/todo-filter-dropdown">>
  todoFilter={{$:/state/projectify/todo-filter!!filter}}
  showProjectLinks="yes"
>
  <$edit-text class="py-input input-larger" tiddler=<<stateTiddler>> field="filter"/>
  <span class="tc-popup-keep">
    <$button popup=<<popupTiddler>> class="tc-btn-invisible">
      {{$:/core/images/down-arrow}}
    </$button>
  </span>

  <$reveal state=<<popupTiddler>> type="popup" position="belowleft">
    <div class="tc-drop-down py-drop-down">
      <$button class="tc-btn-invisible">
        Outstanding
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        In Progress
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]status[in-progress]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Waiting
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]status[waiting]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Someday / Maybe
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]status[someday]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Recurring
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]has[recur]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Scheduled
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]has[due]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        High priority
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]priority[3]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Medium priority
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]priority[2]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Low priority
        <$action-setfield $tiddler=<<stateTiddler>> filter="[!tag[done]priority[1]]"/>
      </$button>
      <$button class="tc-btn-invisible">
        Completed
        <$action-setfield $tiddler=<<stateTiddler>> filter="[tag[done]]"/>
      </$button>
    </div>
  </$reveal>

  <dl>
    <$count filter=<<py-filtered-todos>>/> {{$:/language/Search/Filter/Matches}}
    <$list filter=<<py-filtered-todos>> template="$:/plugins/mblackman/projectify/ui/todo/TodoItem"/>
  </dl>
</$let>
