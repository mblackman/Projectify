\procedure lingo-base() $:/language/projectify/

\procedure add-todo-actions()
<$action-py-quick-add
  $state=<<stateTiddler>>
  $field="todo-name"
  $tags=<<todo-tags>>
/>
\end

<$let stateTiddler=<<qualify "$:/temp/projectify/add-todo-form">>>
  <div class="py-composite-input">
    <$py-quick-input
      class="py-input"
      tiddler=<<stateTiddler>>
      field="todo-name"
      placeholder=<<placeholder>>
      actions=<<add-todo-actions>>
    />

    <div class="py-todo-actions">
      <$let currentTiddler=<<stateTiddler>>>
        <$transclude $tiddler="$:/plugins/mblackman/projectify/ui/buttons/TodoDueDate" $mode="inline"/>
        <$transclude $tiddler="$:/plugins/mblackman/projectify/ui/buttons/TodoPriority" $mode="inline"/>
      </$let>
    </div>
  </div>
  <div class="py-actions">
    <$button
      class="py-btn btn-primary"
      actions=<<add-todo-actions>>
      tooltip={{$:/language/projectify/AddTodo/Hint}}
      aria-label={{$:/language/projectify/AddTodo/Hint}}
    >
      <<lingo AddTodo/Caption>>
    </$button>
  </div>
</$let>
