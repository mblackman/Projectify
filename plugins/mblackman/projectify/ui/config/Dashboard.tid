\procedure lingo-base() $:/language/projectify/

\procedure projects-view()
<$select tiddler="$:/config/projectify/projects-view">
  <$list filter="list cards">
    <option value=<<currentTiddler>>><$transclude $variable="lingo" title=<<currentTiddler>>/></option>
  </$list>
</$select>
\end

\procedure default-dashboard-tab()
<$select tiddler="$:/config/projectify/DefaultDashboardTab">
  <$list filter="[all[tiddlers+shadows]tag[$:/plugins/mblackman/projectify/tags/dashboard]] [all[tiddlers+shadows]tag[$:/plugins/nico/projectify/tags/dashboard]]">
    <option value=<<currentTiddler>>>
      <$transclude $field="caption"><$text text=<<currentTiddler>>/></$transclude>
    </option>
  </$list>
</$select>
\end

|<<lingo DefaultDashboardTab>> |<<default-dashboard-tab>> |
|<<lingo ViewProjectsAs>> |<<projects-view>> |
