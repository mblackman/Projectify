caption: {{$:/language/ControlPanel/Basics/Caption}}

\procedure lingo-base() $:/language/projectify/

\procedure select-yes-no(configTiddler)
<$select tiddler=<<configTiddler>>>
  <option value="yes">{{$:/language/Yes}}</option>
  <option value="no">{{$:/language/No}}</option>
</$select>
\end

\procedure apply-preset(multiStatus, scheduledDates, boardView, contexts, matrixTab, reviewTab, pushNotifications:"yes")
<$action-setfield $tiddler="$:/config/projectify/EnableMultiStatus" text=<<multiStatus>>/>
<$action-setfield $tiddler="$:/config/projectify/EnableScheduledDates" text=<<scheduledDates>>/>
<$action-setfield $tiddler="$:/config/projectify/EnableBoardView" text=<<boardView>>/>
<$action-setfield $tiddler="$:/config/projectify/EnableContexts" text=<<contexts>>/>
<$action-setfield $tiddler="$:/config/projectify/ShowMatrixTab" text=<<matrixTab>>/>
<$action-setfield $tiddler="$:/config/projectify/ShowReviewTab" text=<<reviewTab>>/>
<$action-setfield $tiddler="$:/config/projectify/EnablePushNotifications" text=<<pushNotifications>>/>
<$action-sendmessage $message="tm-auto-save-wiki"/>
\end

<div class="py-preset-bar">
  <strong><<lingo WorkflowPreset/Label>>: </strong>
  <$button class="py-btn btn-small">
    <<lingo WorkflowPreset/Minimal>>
    <$transclude $variable="apply-preset" multiStatus="no" scheduledDates="no" boardView="no" contexts="no" matrixTab="no" reviewTab="no" pushNotifications="no"/>
  </$button>
  <$button class="py-btn btn-small">
    <<lingo WorkflowPreset/GTD>>
    <$transclude $variable="apply-preset" multiStatus="yes" scheduledDates="yes" boardView="no" contexts="yes" matrixTab="no" reviewTab="yes"/>
  </$button>
  <$button class="py-btn btn-small">
    <<lingo WorkflowPreset/Kanban>>
    <$transclude $variable="apply-preset" multiStatus="yes" scheduledDates="yes" boardView="yes" contexts="no" matrixTab="yes" reviewTab="no"/>
  </$button>
  <$button class="py-btn btn-small">
    <<lingo WorkflowPreset/Full>>
    <$transclude $variable="apply-preset" multiStatus="yes" scheduledDates="yes" boardView="yes" contexts="yes" matrixTab="yes" reviewTab="yes"/>
  </$button>
</div>

