title: $:/plugins/mblackman/projectify/ui/todo/TodoActions
type: text/vnd.tiddlywiki

<span class="py-todo-actions">
  <$list filter="[function[py.open-blockers]]" variable="blocker">
    <$link
      to=<<blocker>>
      overrideClass="py-badge py-badge-blocked"
      tooltip={{{ [[$:/language/projectify/BlockedBy/Caption]get[text]addsuffix[: ]] [<blocker>get[caption]!is[blank]else<blocker>] +[join[]] }}}
    >
      {{$:/plugins/mblackman/projectify/images/lock}}
      <span class="py-badge-blocked-text"><$text text={{{ [<blocker>get[caption]!is[blank]else<blocker>] }}}/></span>
    </$link>
  </$list>

  <%if [function[py.blocking-todos]limit[1]] %>
    <$let blockedList={{{ [function[py.blocking-todos]] +[join[, ]] }}}>
      <span
        class="py-badge py-badge-blocking"
        title={{{ [[$:/language/projectify/Blocking/Caption]get[text]addsuffix[: ]] [<blockedList>] +[join[]] }}}
      >
        {{$:/plugins/mblackman/projectify/images/lock}} <$count filter="[function[py.blocking-todos]]"/>
      </span>
    </$let>
  <%endif%>

  <%if [{!!recur}!is[blank]] %>
    <span class="py-badge py-badge-recur" title={{!!recur}}>
      {{$:/plugins/mblackman/projectify/images/repeat}} <$view field="recur"/>
    </span>
  <%endif%>

  <%if [{$:/config/projectify/EnableContexts}!match[no]] %>
    <$list filter="[all[current]get[context]enlist-input[]]" variable="ctx">
      <span class="py-context-pill"><$text text=<<ctx>>/></span>
    </$list>
  <%endif%>

  <%if [<showProjectLinks>!is[blank]] %>
    <$list filter="[all[current]tags[]filter<py-all-projects-and-subprojects-filter>]">
      <$link to={{!!title}} overrideClass="py-project-link"/>
    </$list>
  <%endif%>

  <%if [subfilter<py-has-start-date>] %>
    <%if [subfilter<py-is-not-scheduled>] %>
      <$let timeTemplate={{{ [function[py.time-template]] }}}>
        <span class="py-badge py-badge-scheduled" title={{$:/language/projectify/StartDate/Tab}}>
          {{$:/plugins/mblackman/projectify/images/sun}} <$view field="scheduled" format="date" template={{$:/language/projectify/DateFormat}}/><%if [subfilter<py-has-scheduled-time>] %> <$view field="scheduled" format="date" template=<<timeTemplate>>/><%endif%>
        </span>
      </$let>
    <%endif%>
  <%endif%>

  <%if [subfilter<py-is-scheduled>] %>
    {{||$:/plugins/mblackman/projectify/ui/buttons/TodoDueDate}}
  <%endif%>
  {{||$:/plugins/mblackman/projectify/ui/buttons/TodoActions}}
</span>
