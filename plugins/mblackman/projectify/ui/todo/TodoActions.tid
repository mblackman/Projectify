\whitespace trim
<span class="py-todo-actions">
  <%if [<currentTiddler>has[priority]] %>
    <%if [<isBoardCard>!match[yes]] %>
      {{||$:/plugins/mblackman/projectify/ui/buttons/TodoPriority}}
    <%endif%>
  <%endif%>

  <%if [all[current]tag[SubProject]] [subfilter<py-has-todos>] %>
    <$button
      class={{{ [<subtaskState>get[text]match[yes]then[tc-btn-invisible py-badge py-subtask-pill py-expanded]else[tc-btn-invisible py-badge py-subtask-pill]] }}}
      set=<<subtaskState>>
      setTo={{{ [<subtaskState>get[text]match[yes]then[no]else[yes]] }}}
      tooltip={{$:/language/projectify/AddSubTasks/Caption}}
    >
      {{||$:/plugins/mblackman/projectify/images/pie}}
      <span><$count filter="[function[py.completed-descendant-todos],<currentTiddler>]"/>/<$count filter="[function[py.descendant-todos],<currentTiddler>]"/></span>
    </$button>
  <%endif%>

  <%if [function[py.open-blockers]limit[1]] %>
    <$let
      firstBlocker={{{ [function[py.open-blockers]first[]] }}}
      blockerCount={{{ [function[py.open-blockers]count[]] }}}
      blockerNames={{{ [function[py.open-blockers]] :map[get[caption]!is[blank]else<currentTiddler>] +[join[, ]] }}}
    >
      <$link
        to=<<firstBlocker>>
        overrideClass="py-badge py-badge-blocked"
        tooltip={{{ [[$:/language/projectify/BlockedBy/Caption]get[text]addsuffix[: ]] [<blockerNames>] +[join[]] }}}
      >
        {{$:/plugins/mblackman/projectify/images/lock}}
        <span class="py-badge-blocked-text"><%if [<isBoardCard>match[yes]] %><$text text=<<blockerCount>>/><%else%><$text text=<<blockerNames>>/><%endif%></span>
      </$link>
    </$let>
  <%endif%>

  <%if [function[py.blocking-todos]limit[1]] %>
    <$let blockedList={{{ [function[py.blocking-todos]] +[join[, ]] }}}>
      <span
        class="py-badge py-badge-blocking"
        title={{{ [[$:/language/projectify/Blocking/Caption]get[text]addsuffix[: ]] [<blockedList>] +[join[]] }}}
      >
        {{$:/plugins/mblackman/projectify/images/lock}}<span><$count filter="[function[py.blocking-todos]]"/></span>
      </span>
    </$let>
  <%endif%>

  <%if [{!!recur}!is[blank]] %>
    <%if [subfilter<py-is-not-scheduled>!has[scheduled]] %>
      <span class="py-badge py-badge-recur" title={{!!recur}}>
        {{$:/plugins/mblackman/projectify/images/repeat}}<span><$view field="recur"/></span>
      </span>
    <%endif%>
  <%endif%>

  <%if [{$:/config/projectify/EnableContexts}!match[no]] %>
    <$list filter="[all[current]get[context]enlist-input[]]" variable="ctx">
      <span class="py-context-pill"><$text text=<<ctx>>/></span>
    </$list>
  <%endif%>

  <%if [<showProjectLinks>!is[blank]] %>
    <$list filter="[all[current]tags[]filter<py-all-projects-and-subprojects-filter>]">
      <$link to={{!!title}} overrideClass="py-project-link"/>
    </$list>
  <%endif%>

  <%if [subfilter<py-is-scheduled>] [subfilter<py-has-start-date>] %>
    {{||$:/plugins/mblackman/projectify/ui/buttons/TodoDueDate}}
  <%endif%>
</span>
