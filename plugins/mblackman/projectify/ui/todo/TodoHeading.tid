tags: $:/tags/ViewTemplate
title: $:/plugins/mblackman/projectify/ui/todo/TodoHeading
type: text/vnd.tiddlywiki

\procedure lingo-base() $:/language/projectify/

<%if [subfilter<py-is-todo>] %>
  <div class="py-todo-heading">
    {{||$:/plugins/mblackman/projectify/ui/buttons/TodoDueDate}}
    {{||$:/plugins/mblackman/projectify/ui/buttons/TodoPriority}}
    <%if [{$:/config/projectify/EnableMultiStatus}!match[no]] %>
      {{||$:/plugins/mblackman/projectify/ui/forms/TodoStatus}}
    <%endif%>

    <$let popupTiddler=<<qualify "$:/state/projectify/todo-heading-dropdown">>>
      <$button
        popup=<<popupTiddler>>
        class="py-btn"
        tooltip={{$:/language/projectify/MoreActions/Hint}}
        aria-label={{$:/language/projectify/MoreActions/Hint}}
      >
        <<lingo More>> {{$:/core/images/down-arrow}}
      </$button>

      <$reveal state=<<popupTiddler>> type="popup" class="tc-drop-down py-drop-down" position="below">
        <%if [subfilter<py-is-not-subproject>] %>
          <$button class="tc-btn-invisible">
            {{$:/plugins/mblackman/projectify/images/checklist}} <<lingo AddSubTasks/Caption>>
            <$action-listops $tags="[[SubProject]]"/>
            <$action-sendmessage $message="tm-auto-save-wiki"/>
          </$button>
        <%endif%>

        <%if [{$:/config/projectify/EnableContexts}!match[no]] %>
          <hr/>
          {{||$:/plugins/mblackman/projectify/ui/forms/TodoContext}}
        <%endif%>

        <hr/>
        <div class="py-dependency-picker tc-popup-handle">
          <label class="py-label tc-popup-handle">{{$:/plugins/mblackman/projectify/images/lock}} <<lingo BlockedBy/Caption>></label>
          <$select field="blocked-by" default="" class="py-select-compact py-select-full tc-popup-handle">
            <option value="">—</option>
            <$list filter="[all[tiddlers]tag[todo]!has[draft.of]!tag[done]!title<currentTiddler>sort[title]]" variable="blocker">
              <option value={{{ [<blocker>format:titlelist[]] }}}><$text text=<<blocker>>/></option>
            </$list>
          </$select>
        </div>

        <hr/>
        {{||$:/plugins/mblackman/projectify/ui/forms/TodoConvert}}
      </$reveal>
    </$let>
  </div>

  <%if [function[py.has-open-blocker]] [function[py.blocking-todos]limit[1]] %>
    <div class="py-dependency-banners">
      <%if [function[py.has-open-blocker]] %>
        <div class="py-dependency-banner py-banner-blocked">
          <span class="py-dependency-banner-label">
            {{$:/plugins/mblackman/projectify/images/lock}} <<lingo BlockedBy/Caption>>:
          </span>
          <div class="py-dependency-banner-items">
            <$list filter="[function[py.open-blockers]]" variable="blocker">
              <span class="py-dependency-chip">
                <$let currentTiddler=<<blocker>>>
                  <$button class="tc-btn-invisible py-todo-check-btn">
                    <$action-py-toggle-todo $tiddler=<<blocker>>/>
                    {{||$:/plugins/mblackman/projectify/ui/buttons/Checkbox}}
                  </$button>
                  <$link to=<<blocker>>>{{||$:/plugins/mblackman/projectify/ui/todo/TodoCaption}}</$link>
                </$let>
              </span>
            </$list>
          </div>
          <$button
            class="tc-btn-invisible py-dependency-clear"
            tooltip={{$:/language/projectify/ClearBlocker/Hint}}
            aria-label={{$:/language/projectify/ClearBlocker/Hint}}
          >
            {{$:/core/images/close-button}}
            <$action-deletefield $field="blocked-by"/>
            <$action-sendmessage $message="tm-auto-save-wiki"/>
          </$button>
        </div>
      <%endif%>

      <%if [function[py.blocking-todos]limit[1]] %>
        <div class="py-dependency-banner py-banner-blocking">
          <span class="py-dependency-banner-label">
            {{$:/plugins/mblackman/projectify/images/lock}} <<lingo Blocking/Caption>>:
          </span>
          <div class="py-dependency-banner-items">
            <$list filter="[function[py.blocking-todos]]" variable="dependent">
              <span class="py-dependency-chip">
                <$let currentTiddler=<<dependent>>>
                  <$link to=<<dependent>>>{{||$:/plugins/mblackman/projectify/ui/todo/TodoCaption}}</$link>
                </$let>
              </span>
            </$list>
          </div>
        </div>
      <%endif%>
    </div>
  <%endif%>
<%endif%>
