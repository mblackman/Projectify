{
  "description": "TiddlyWiki Projectify Demo & Development Wiki",
  "plugins": [
    "tiddlywiki/tiddlyweb",
    "tiddlywiki/filesystem",
    "tiddlywiki/highlight",
    "tiddlywiki/pluginlibrary",
    "mblackman/projectify"
  ],
  "themes": [
    "tiddlywiki/vanilla",
    "tiddlywiki/snowwhite"
  ],
  "build": {
    "index": [
      "--rendertiddler",
      "$:/plugins/tiddlywiki/tiddlyweb/save/offline",
      "index.html",
      "text/plain"
    ],
    "projectify": [
      "--rendertiddler",
      "$:/plugins/mblackman/projectify",
      "projectify.tid",
      "text/plain",
      "$:/core/templates/exporters/TidFile",
      "exportFilter",
      "[<currentTiddler>]",
      "--rendertiddler",
      "$:/plugins/mblackman/projectify",
      "projectify-plugin.json",
      "text/plain",
      "$:/core/templates/json-tiddler"
    ],
    "library": [
      "--makelibrary",
      "$:/UpgradeLibrary",
      "--savelibrarytiddlers",
      "$:/UpgradeLibrary",
      "[prefix[$:/plugins/mblackman/]]",
      "recipes/library/tiddlers/",
      "$:/UpgradeLibrary/List",
      "--savetiddler",
      "$:/UpgradeLibrary/List",
      "recipes/library/tiddlers.json",
      "--rendertiddler",
      "$:/plugins/tiddlywiki/pluginlibrary/library.template.html",
      "index.html",
      "text/plain"
    ]
  }
}
