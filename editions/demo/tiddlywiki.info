{
    "description": "Projectify website",
	"plugins": [
        "tiddlywiki/tiddlyweb",
        "tiddlywiki/filesystem",
		"mblackman/projectify"
    ],
    "themes": [
        "tiddlywiki/vanilla",
        "tiddlywiki/snowwhite"
    ],
	"build": {
        "index": [
            "--rendertiddler",
			"$:/plugins/tiddlywiki/tiddlyweb/save/offline",
            "demo.html",
            "text/plain"
        ],
		"readme": [
			"--rendertiddler","Readme","README.md","text/html"
		],
		"plugin": [
			"--rendertiddler",
			"$:/plugins/mblackman/projectify",
			"projectify.json",
			"text/plain",
			"$:/core/templates/json-tiddler"
		]
    }
}
